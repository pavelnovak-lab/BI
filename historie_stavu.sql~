SELECT "V_BI_UMZPROJEKT"."Registraèní èíslo projektu" as "Registraèní èíslo projektu",
--       "V_BI_UMSWFHISTORIESTAVU"."Unikátní kód stavu do" as "Unikátní kód stavu do",
       "V_BI_UMSWFHISTORIESTAVU"."STAVDONAZEV" as "STAVDONAZEV",
       "V_BI_UMSWFHISTORIESTAVU"."STAVDO", 
       "V_BI_UMSWFHISTORIESTAVU"."LAST_MODIF_UZIVATEL" as "LAST_MODIF_UZIVATEL",
       "V_BI_UMSWFHISTORIESTAVU"."DATUMOD" as "DATUMOD",
       "V_BI_UMFPFCELKEM"."Evropský fond pro regionální r" as "Evropský fond pro regionální r",
       "V_BI_UMFPFCELKEM"."LAST_MODIF_CAS" as "LAST_MODIF_CAS",
       "V_BI_UMFPFFAZE"."KOD" as "KOD",
       "V_BI_UMFPFFAZE"."NAZEV" as "NAZEV",
       "V_BI_UMZPROJEKT"."Integrovaný" as "Integrovaný" 

FROM   "ISUM"."V_BI_UMFPFFAZE" "V_BI_UMFPFFAZE",
       "ISUM"."V_BI_UMFPFCELKEM" "V_BI_UMFPFCELKEM",
       "ISUM"."V_BI_UMSWFHISTORIESTAVU" "V_BI_UMSWFHISTORIESTAVU",
       "ISUM"."V_BI_UMZPROJEKT" "V_BI_UMZPROJEKT" 

WHERE  "V_BI_UMSWFHISTORIESTAVU"."NOSITELID"="V_BI_UMZPROJEKT"."ID"
AND "V_BI_UMFPFCELKEM"."ID_PROJEKT"="V_BI_UMZPROJEKT"."ID"
AND "V_BI_UMFPFCELKEM"."ID_FAZE"="V_BI_UMFPFFAZE"."ID"

-- AND "V_BI_UMSWFHISTORIESTAVU"."Unikátní kód stavu do" ='CPP12' 
AND "V_BI_UMSWFHISTORIESTAVU"."STAVDO" = 'PP30' 
AND "V_BI_UMFPFFAZE"."KOD" ='AKT' 
AND "V_BI_UMZPROJEKT"."Integrovaný" ='N'

