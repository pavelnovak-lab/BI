SELECT	 
v."Číslo výzvy" as "Číslo výzvy",
p."Registrační číslo projektu",
p."Název projektu CZ",
(select cis.kurz
                from isum.v_bi_UMSCisKurzyMen cis
                inner join isum.v_bi_umsciszakladni domena on domena.id=cis.id_domeny
                where to_char(cis.datumod,'yyyyMM')=to_char(s."Datum uzavření",'yyyyMM')
                and domena."Kód"='CZK') as KURZ
FROM
isum.V_BI_UMZVYZVA v
inner join isum.V_BI_UMZPRJGGII p on p.id_vyzva=v.id
inner join isum.v_bi_umfsmlouva s on s.id_nositelsml=p.ID and s.minporadisml=s."Pořadí"
WHERE
p."Registrační číslo projektu" is not null



