-- left JOIN 	isum.V_BI_UMSHIUtvarKomp kom ON kom.id=utvar.id_utvarkomp

WHERE 	p."Registraèní èíslo projektu" in ('CZ.31.4.0/0.0/0.0/22_017/0003251', 'CZ.31.1.0/0.0/0.0/22_011/0004161'
-- AND 	kom."Název"<>'Operaèní program Podnikání a inovace pro konkurenceschopnost'
-- AND 	ci."Kód" like :nace
-- AND	p.kodWFstav like ('PP%')
-- AND 	n."Je souèástí projektu?" = 'A'
AND      p.KodPrioritniOsa in ('31.1', '31.2', '31.3', '31.4','31.5','31.9','31.22','31.14')

