SELECT rsp.* 


INNER JOIN rozpocet_skupina sk -- ON sk.id = hr.id_skupina
INNER JOIN rozpocet_skupina_polozka rsp ON rsp.id_predpis = sk.id

WHERE sk.id = 19688663
AND EXISTS (SELECT 1
    	    FROM rozpocet_skupina_polozka
	    WHERE "Rozpad položky pro partnery s finančním příspěvkem" = 'A' )
