SELECT CASE WHEN neinv.uroven = srp.

FROM rozpocet_skupina sr 
JOIN (SELECT min(Úroveň) uroven,
     	     id_predpis
      FROM rozpocet_skupina_polozka
      WHERE "Investice / Neinvesticeon" = 0) neinv ON neinv.id_predpis = sr.id 
JOIN (SELECT min(Úroveň) uroven,
     	     id_predpis
      FROM rozpocet_skupina_polozka 
      WHERE "Investice / Neinvesticeon" = 1) inv ON neinv.id_predpis = sr.id 
JOIN rozpocet_skupina_polozka srp ON srp.id_predpis = sr.id


where sr.id = 264655744
