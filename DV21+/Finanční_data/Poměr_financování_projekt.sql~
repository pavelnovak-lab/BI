SELECT op.nazev as "Opatøení" ,
       p."Registraèní èíslo projektu" ,
       w."Kód" "Kód stavu" ,
       max(CASE WHEN pf.id_faze = 99991000000000005 THEN pf."Pøíspìvek Unie"
       END ) "Dotace po zmìnì",
       max(CASE WHEN pf.id_faze = 99991000000000011 THEN pf."Pøíspìvek Unie" 
       END ) "Dotace RoPD",
       max(CASE WHEN pr.id_faze = 99991000000000005 THEN pf."Pøíspìvek spoleèenství (% veøejných)"
       END) "% EU po zmìnì",
       max(CASE WHEN pr.id_faze = 99991000000000005 THEN pf."Pøíspìvek spoleèenství (% veøejných)"
       END) "% EU RoPD"
FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN v_rav_umshisc op on op.id=vh.id_speccil
INNER JOIN prehled_zdroju_financovani pf ON pf.id_projekt = p.id AND pf.id_faze = (99991000000000005, 99991000000000011) -- aktuální stav , RoPD
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id
INNER JOIN ciselnik_faze_prjektu faze ON pf.id_faze


WHERE p."Registraèní èíslo projektu" is not null
AND w."Kód" not like 'PN%'


GROUP BY op.nazev  ,
       p."Registraèní èíslo projektu" ,
       w."Kód" 
