SELECT DISTINCT  v."Číslo výzvy" ,
       v."Název výzvy" ,
       c."Kód",
       c."Název",
       vponeinv."Název" "VPo NEINV",
       vpoinv."Název" "VPo INV"

FROM vyzva AS v
INNER JOIN vyzva_matricni_data AS md ON md.id_vyzva = v.id AND md."Platný" = 'A'
INNER JOIN ciselnik_skupina_rozpoctu AS c ON c.id = md.id_ciszakladni
INNER JOIN (SELECT DISTINCT id_predpis ,
      	   	   id_verejnapodpora
      	    FROM rozpocet_skupina_polozka
	    WHERE "Investice / Neinvestice" = 1
	    AND "Listová" = 'A') inv ON inv.id_predpis = md.id_ciszakladni
INNER JOIN (SELECT DISTINCT id_predpis ,
      	   	   id_verejnapodpora
      	    FROM rozpocet_skupina_polozka
	    WHERE "Investice / Neinvestice" = 0
	    AND "Listová" = 'A') neinv ON neinv.id_predpis = md.id_ciszakladni
-- INNER JOIN rozpocet_skupina_polozka pol ON pol.id_predpis = md.id_ciszakladni
INNER JOIN ciselnik_kombinace_verejne_podpory vponeinv ON neinv.id_verejnapodpora = vponeinv.id
INNER JOIN ciselnik_kombinace_verejne_podpory vpoinv ON inv.id_verejnapodpora = vpoinv.id 
WHERE -- v."Číslo výzvy" <> '01_24_049'
-- AND
inv.id_verejnapodpora <> neinv.id_verejnapodpora

ORDER BY v."Číslo výzvy" 
