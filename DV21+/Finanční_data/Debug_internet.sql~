SELECT p."Registrační číslo projektu",
       pzf.*

FROM isum.v_bi_UmzProjekt p 
INNER JOIN isum.v_bi_UMFPFCelkem pzf ON pzf.id_projekt = p.id -- AND pzf.id_faze = 99991000000000005 -- aktuální stav 


WHERE pzf.id_faze IN  (99991000000000005, 99991000000000011)

WHERE p."Registrační číslo projektu" = 'CZ.31.1.0/0.0/0.0/24_135/0010838'



