SELECT sc.kodnovy as  "Kód SC",
       substring(prg."Kód",4) "Kód Priority",
       op.nazev as "Opatøení",
       v."Èíslo výzvy" ,
       p."Registraèní èíslo projektu" ,
       pl."Èíslo platby" ,
       w."Kód" "Souèasný stav ®oP",
       pl."Datum zmìny stavu",
       pl."Verze ®oP", 
       pl."Poøadí finanèního plánu" "Poøadí ®oP",
       pz.p "Poèet ®oP na projektu",
       CASE WHEN pl."Poøadí finanèního plánu" = 1 THEN 0
       	    ELSE (CASE WHEN pl.id_wfstav = 405643 THEN (pz."Poèet ®oP v PP11" - 1)/pz.p
	    	       ELSE pz."Poèet ®oP v PP11"/pz.p  END)
 	    END AS "% pøedchozích krácených ®oP",
       -- s."Název subjektu" "Pøíjemce",
       -- maximum, abych potlaèil nulový výstup, kdy¾ je podmínka vyhodnocena jako NE. 
       -- CASE WHEN kr."Typ krácení" = '0' THEN 'Vìcné'
       -- 	    WHEN kr."Typ krácení" = '1' THEN 'VR'
       -- 	    WHEN kr."Typ krácení" = '2' THEN 'Jiné'
       -- 	    END
       -- ) "Typ krácení 0 - vìcné, 1 - VR, 2 - jiné",

       pl."Zálohová platba",
       pl."Závìreèná platba" , 
       
       sd."VZ" "Poèet pro ®oP relevnantní VZ ",
       sd."Poèet dokladù s krácením",
       sd."Poèet dokladù",
       sd."Celkem kráceno na dokladech",

       c."Vlastní výdaje (Schválené)",
       c."Výdaje EU (Schválené)" ,

       sum(kr."Krácení celkem") "Celkem kráceno",
       GROUP_CONCAT(DISTINCT typk."Název CZ") "Zpùsob provedení krácení",
       GROUP_CONCAT(DISTINCT kr."Typ krácení" ) "Typ krácení 0 - vìcné, 1 - VR, 2 - jiné",
       p."Evidován v BL",
       CASE WHEN trp.id_prjgg is null THEN 'N'
       	    ELSE 'A' END "Tag rizikový projekt" ,
       pf."Právní forma" "Právní forma pøíjemce" ,
       s."Poèet zamìstnancù",
       vp."Velikost kategorie podniku",
       CASE WHEN pa.id_prjgg is null THEN 'N'
       	    ELSE 'A' END "Administruje PA" ,
       pzf."Pøíspìvek Unie" "EU dotace projekt" ,
       pzf."Celkové zdroje pøipadající na zpùsobilé výdaje" "CZV projekt" 
       
       
FROM projekt p
INNER JOIN vyzva v on v.id = p.id_vyzva 
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN v_rav_umshisc op on op.id=vh.id_speccil 
INNER JOIN v_rav_umshisc sc on sc.id=op.id_hierarchie
INNER JOIN programova_linie prg ON prg.id = sc.id_osa
INNER JOIN platba pl ON pl.id_nositelplatby = p.id
INNER JOIN (SELECT count(id) p,
      	   	   sum(CASE WHEN id_wfstav = 405643 then 1
		   	ELSE 0 END ) "Poèet ®oP v PP11",
      	   	   id_nositelplatby
     	    FROM platba
	    WHERE "Souètový øádek" is null
	    GROUP BY id_nositelplatby) pz ON pz.id_nositelplatby = p.id 
INNER JOIN ciselnik_stav_workflow w ON pl.id_wfstav = w.id  
LEFT JOIN korekce kr ON kr.id_platba = pl.id  AND kr.id_typkorekce > 0 -- není souètovým øádkem na F1-B
LEFT JOIN ciselnik_typ_korekce typk ON typk.id = kr.id_typkorekce
INNER JOIN (SELECT sum(CASE WHEN cuk."Kód" in ('8','9','10','11','12','13') THEN rf."Schválené vyúètování ZS/ØO v této ®oP" 
       	    	   	    END) "Vlastní výdaje (Schválené)",
 		   max(CASE WHEN cuk."Kód" in ('7') THEN rf."Schválené vyúètování ZS/ØO v této ®oP" 
	    	   	    END) "Výdaje EU (Schválené)",
	           rf.id_platba
		   FROM rozpis_financovani rf 
		   INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk ON cuk.id = rf.id_ukazatel AND cuk."Kód" in ('7','8','9','10','11','12','13')
		   GROUP BY rf.id_platba) c ON c.id_platba = pl.id 
INNER JOIN prehled_zdroju_financovani pzf ON pzf.id_projekt = p.id AND pzf.id_faze = 99991000000000005 -- aktuální stav 
INNER JOIN subjekt s ON s.id_prjgg = p.id AND s."Neplatný od" is null AND s.id_typsubjektuedit IN (413462) -- ¾adatel, partner s FP
INNER JOIN ciselnik_pravni_forma pf on pf.id = s.id_hosppravforma 
INNER JOIN ciselnik_velikost_podniku vp ON vp.id = s.id_velikostpodniku
LEFT JOIN (SELECT id_prjgg
     	   FROM subjekt
 	   WHERE "Neplatný od" IS NULL
	   AND id_typsubjektuedit = 413437 /* poradenka */ ) AS pa ON pa.id_prjgg = p.id

LEFT JOIN (SELECT COUNT(DISTINCT 
			CASE WHEN id_vz > 0 then id_vz
			     ELSE null END ) "VZ",
      	   	   SUM(CASE WHEN "Sní¾ení prokazovaných zpùsobilých \nvýdajù" > 0 THEN 1
		   	    ELSE 0 END) AS "Poèet dokladù s krácením",
		   COUNT(id) "Poèet dokladù",
		   SUM("Sní¾ení prokazovaných zpùsobilých \nvýdajù") "Celkem kráceno na dokladech",
		   id_platba
      	    FROM soupiska_doklad
	    WHERE "Souètový øádek" is null
	    GROUP BY id_platba) sd  ON pl.id = sd.id_platba 
LEFT JOIN (SELECT t.id_prjgg 		  
		  FROM tag t 
		  INNER JOIN ciselnik_tagy_projektu ct on ct.id = t.id_tag
		  WHERE ct."Název" = 'Rizikový projekt obecnì') trp ON trp.id_prjgg = p.id 

WHERE pl."Èíslo platby" is not null 
-- AND pl."Èíslo platby" IN ( 'CZ.01.01.01/02/22_003/0000133/2025/001/POST','CZ.01.04.01/01/22_006/0000001/2024/001/POST','CZ.01.04.01/01/22_006/0000380/2024/001/POST','CZ.01.04.02/01/22_007/0000017/2024/001/POST','CZ.01.01.01/07/23_011/0001296/2024/002/POST','CZ.01.01.01/01/22_002/0000436/2024/001/POST','CZ.01.01.01/04/23_031/0003515/2025/001/POST')
-- AND pl."Èíslo platby" = 'CZ.01.04.02/01/22_007/0001103/2024/001/POST'

GROUP BY  sc.kodnovy ,
       substring(prg."Kód",4),
       op.nazev,
       v."Èíslo výzvy" ,
       p."Registraèní èíslo projektu" ,
       pl."Èíslo platby" ,
       w."Kód" ,
       pl."Datum zmìny stavu",
       pl."Verze ®oP", 
       pl."Poøadí finanèního plánu" ,
       pz.p , 
       pl."Zálohová platba",
       pl."Závìreèná platba" ,
       "Poèet pro ®oP relevnantní VZ ",
       sd."Poèet dokladù s krácením",
       sd."Poèet dokladù",
       sd."Celkem kráceno na dokladech" ,
       c."Vlastní výdaje (Schválené)",
       "% pøedchozích krácených ®oP"  ,
       c."Výdaje EU (Schválené)" ,
       p."Evidován v BL",
       "Tag rizikový projekt",
       "Právní forma pøíjemce" ,
       "Právní forma pøíjemce" ,
       s."Poèet zamìstnancù",
       vp."Velikost kategorie podniku",
       "Administruje PA" ,
       "EU dotace projekt" ,
       "CZV projekt" 

ORDER BY "% pøedchozích krácených ®oP" DESC 
