        AND rozpadlici.id_rozpis = rsp.id
        AND rsp."Rozpad položky pro partnery s finančním příspěvkem" = 'A'
    LEFT JOIN rozpocet_polozka pol ON pol.id_hierarchie = rozpadlici.id 
        AND pol."Název" = s."Název subjektu"
    LEFT JOIN rozpocet_polozka pol_direct ON pol_direct.id_hlavicka = hl.id
        AND pol_direct.id_rozpis = rsp.id
        AND (rsp."Rozpad položky pro partnery s finančním příspěvkem" IS NULL 
             OR rsp."Rozpad položky pro partnery s finančním příspěvkem" != 'A')
    INNER JOIN ciselnik_kombinace_verejne_podpory kvpo ON rsp.id_verejnapodpora = kvpo.id
    INNER JOIN verejna_podpora vpo ON vpo.id_verejnapodpora = kvpo.id 
        AND vpo.id_projekt = pd.id 
        AND vpo.id_nositel = s.id
    INNER JOIN pomery_financovani pf ON pf.id_nositelpompf = vpo.id 
        AND pf.id_zdrojfin = 415432
    WHERE (pol.id IS NOT NULL OR pol_direct.id IS NOT NULL)
    GROUP BY pd."Registrační číslo projektu", pd.id
),
-- Transformace pravdivých dat na ukazatele
pravdive_udaje AS (
    SELECT "Registrační číslo projektu",
           projekt_id,
           '7' AS "Ukazatel",
           CAST(("EU-INV" + "EU-NEINV") AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        projekt_id,
        '7a' AS "Ukazatel",
        CAST("EU-INV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        projekt_id,
        '7b' AS "Ukazatel",
        CAST("EU-NEINV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        projekt_id,
        '7c' AS "Ukazatel",
        CONCAT(
            CAST(ROUND(CASE WHEN suma_inv > 0 THEN "EU-INV" / suma_inv * 100 ELSE 0 END, 2) AS VARCHAR),
            '; ',
            CAST(ROUND(CASE WHEN suma_neinv > 0 THEN "EU-NEINV" / suma_neinv * 100 ELSE 0 END, 2) AS VARCHAR)
        ) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
),
-- Krácení data
kraceni_data AS (
    SELECT 
        p.id AS projekt_id,
        pl.id AS platba_id,
        SUM(k."Investice") AS kr_inv,
        SUM(k."Krácení celkem") AS kr_celk,
        SUM(k."Neinvestice") AS kr_neinv
    FROM projekty_filter p
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id 
    INNER JOIN korekce k ON k.id_platba = pl.id AND k."Typ krácení" = 2  -- krácení jiné
    GROUP BY p.id, pl.id
)

-- Finální dotaz
SELECT 
    op."Název specifického cíle/opatření" AS "Opatření",
    pa."Příjemce",
    p."Registrační číslo projektu",
    sz.posledni_zop AS "Pořadí ŽoP",
    wpl."Kód" "Stav ŽoP",
    pl."Závěrečná platba",
    
    cuk."Kód" AS "Ukazatel",
    -- Aktuální rozpis
    CASE cuk."Kód"
        WHEN '7' THEN rd."EU"
        WHEN '7a' THEN rd."EU-INV"
        WHEN '7b' THEN rd."EU-NEINV"
        WHEN '7c' THEN rd."PROCENTO"
    END AS "Aktuální rozpis financování projektu",
    pu."Pravdivý rozpis financování projektu",
    rf."Předložené vyúčtování v toto ŽoP" AS "Požadováno příjemcem v této ŽoP",
    rf."Schválené vyúčtování ZS/ŘO v této ŽoP",
    -- Disponibilní alokace
    CASE 
        WHEN cuk."Kód" IN ('7', '7a', '7b') THEN 
            rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP"
        WHEN cuk."Kód" = '7c' THEN 
            ROUND(100 * hk7.hodnota_7 / NULLIF(rd."CZV", 0), 2)
    END AS "Aktuální disponibilní alokace projektu včetně této ŽoP",
    sz."Schváleno a proplaceno v této ŽoP" AS "Schváleno a proplaceno za projekt včetně této ŽoP",
    rf."Aktuální zůstatek k proplacení za projekt",
    
    -- Krácení sloupec
    CASE cuk."Kód"
        WHEN '7' THEN kr.kr_celk
        WHEN '7a' THEN kr.kr_inv
        WHEN '7b' THEN kr.kr_neinv
        WHEN '7c' THEN ROUND(100 * kr.kr_celk / NULLIF(rd."CZV", 0), 2)
    END AS "Krácení"

FROM projekty_filter p
INNER JOIN vyzva v ON v.id = p.id_vyzva
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN specificky_cil op ON op.id = vh.id_speccil
INNER JOIN starsi_zop sz ON sz.projekt_id = p.id
INNER JOIN platba pl ON pl.id_nositelplatby = p.id
    AND pl."Pořadí finančního plánu" = sz.posledni_zop
INNER JOIN ciselnik_stav_workflow wpl ON pl.id_wfstav = wpl.id   
INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
    ON cuk.id = rf.id_ukazatel 
    AND cuk."Kód" = sz."Kód"
INNER JOIN rozpis_data rd 
    ON rd."Registrační číslo projektu" = p."Registrační číslo projektu"
INNER JOIN pravdive_udaje pu
    ON pu."Registrační číslo projektu" = p."Registrační číslo projektu"
    AND pu."Ukazatel" = cuk."Kód"
INNER JOIN hodnoty_kod_7 hk7
    ON hk7."Registrační číslo projektu" = p."Registrační číslo projektu"
INNER JOIN pravdive_agregace pa ON pa.projekt_id = p.id  -- změněno na vazbu přes ID
LEFT JOIN kraceni_data kr ON kr.projekt_id = p.id AND kr.platba_id = pl.id  -- LEFT JOIN pro případ, že krácení neexistuje

ORDER BY 
    p."Registrační číslo projektu",
    CASE cuk."Kód"
        WHEN '7' THEN 1
        WHEN '7a' THEN 2
        WHEN '7b' THEN 3
        WHEN '7c' THEN 4
    END;



--- Dopsat podmínku INV a NEINV v rozpočtu

