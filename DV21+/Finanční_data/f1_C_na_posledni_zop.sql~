        bd.posledni_zop
    FROM suma_kod_7 s7
    INNER JOIN suma_kod_1 s1 ON s7.projekt_id = s1.projekt_id
    INNER JOIN (SELECT DISTINCT projekt_id, "Registrační číslo projektu", posledni_zop FROM base_data) bd 
        ON bd.projekt_id = s7.projekt_id
),
posledni_zop_cislo AS (
    -- Získání čísla poslední ŽoP pro každý projekt
    SELECT DISTINCT projekt_id, posledni_zop
    FROM base_data
),
-- Data pro aktuální rozpis financování
rozpis_data AS (
    SELECT p."Registrační číslo projektu", 
        max(CASE WHEN pzfinv.id_kategorieregionu in (283463, 283468) AND pzfinv."Investice (A)/Neinvestice (N)" = 'A' 
                 THEN pzfinv."Příspěvek Unie" END) as "EU-INV",
        max(CASE WHEN pzfinv.id_kategorieregionu in (283463, 283468) AND pzfinv."Investice (A)/Neinvestice (N)" = 'N' 
                 THEN pzfinv."Příspěvek Unie" END) as "EU-NEINV",
        pf."Příspěvek Unie" as "EU",
        pf."Celkové zdroje připadající na způsobilé výdaje" "CZV" ,
        pf."Příspěvek společenství (% veřejných)" as "PROCENTO"
    FROM projekt p 
    INNER JOIN prehled_zdroju_financovani_sckr_investice pzfinv ON pzfinv.id_projekt = p.id 
          AND id_faze = 99991000000050005
    INNER JOIN prehled_zdroju_financovani pf ON pf.id_projekt = p.id AND pf.id_faze = 99991000000000005
    WHERE p."Registrační číslo projektu" IN (
        'CZ.01.01.01/08/23_036/0005283',
        'CZ.01.01.01/08/23_036/0005308',
        'CZ.01.01.01/08/23_036/0005174'
    )	
    GROUP BY p."Registrační číslo projektu", pf."Příspěvek Unie", pf."Celkové zdroje připadající na způsobilé výdaje", pf."Příspěvek společenství (% veřejných)"
),
aktualni_rozpis AS (
    SELECT "Registrační číslo projektu",
           '7' as "Ukazatel",
           "EU" as "Aktuální rozpis financování projektu"
    FROM rozpis_data
    
    UNION ALL
    
    SELECT "Registrační číslo projektu",
           '7a' as "Ukazatel",
           "EU-INV" as "Aktuální rozpis financování projektu"
    FROM rozpis_data
    
    UNION ALL
    
    SELECT "Registrační číslo projektu",
           '7b' as "Ukazatel",
           "EU-NEINV" as "Aktuální rozpis financování projektu"
    FROM rozpis_data
    
    UNION ALL
    
    SELECT "Registrační číslo projektu",
           '7c' as "Ukazatel",
           "PROCENTO" as "Aktuální rozpis financování projektu"
    FROM rozpis_data
),
-- Získání hodnot pro řádek 7 každého projektu
hodnoty_kod_7 AS (
    SELECT 
        p."Registrační číslo projektu",
        rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP" AS hodnota_7
    FROM projekt p 
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id
    INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id 
    INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
        ON cuk.id = rf.id_ukazatel 
        AND cuk."Kód" = '7'
    INNER JOIN posledni_zop_cislo pz 
        ON pz.projekt_id = p.id 
        AND pl."Pořadí finančního plánu" = pz.posledni_zop
    LEFT JOIN starsi_zop sz 
        ON sz."Registrační číslo projektu" = p."Registrační číslo projektu" 
        AND sz."Kód" = '7'
    WHERE p."Registrační číslo projektu" IN (
        'CZ.01.01.01/08/23_036/0005283',
        'CZ.01.01.01/08/23_036/0005308',
        'CZ.01.01.01/08/23_036/0005174'
    )
),
-- PRAVDIVÁ DATA Z PROJEKTU
inv_polozky AS (
    SELECT 
        id,
        id_verejnapodpora,
        id_predpis,
        "Investice / Neinvestice" AS inv
    FROM rozpocet_skupina_polozka
    WHERE "Rozpad položky pro partnery s finančním příspěvkem" = 'A'
        AND "Listová" = 'A'
        AND "Platnost" = 'A'
),
projekt_data AS (
    SELECT 
        p.id,
        p."Registrační číslo projektu",
        s.id AS subjekt_id,
        s."Název subjektu",
        hl.id AS hlavicka_id,
        hl.id_skupina
    FROM projekt p
    INNER JOIN subjekt s ON s.id_prjgg = p.id 
        AND s."Neplatný od" IS NULL 
        AND s.id_typsubjektuedit IN (413462, 413467)
    INNER JOIN rozpocet_hlavicka hl ON hl.id_nrozpocet = p.id 
        AND hl."Aktuální" = 'A'
    WHERE p."Registrační číslo projektu" IN (
        'CZ.01.01.01/08/23_036/0005283',
        'CZ.01.01.01/08/23_036/0005308',
        'CZ.01.01.01/08/23_036/0005174'
    )
),
detail_data AS (
    SELECT 
        pd."Registrační číslo projektu",
        inv.inv,
        pf.id_kategorieregionu,
        pf."Doporučený poměr financování (%)" AS pomer,
        pol."Částka celkem" AS castka
    FROM projekt_data pd
    INNER JOIN rozpocet_skupina sr ON sr.id = pd.id_skupina
    LEFT JOIN inv_polozky inv ON inv.id_predpis = sr.id
    INNER JOIN rozpocet_polozka rozpadlici ON rozpadlici.id_hlavicka = pd.hlavicka_id 
        AND rozpadlici.id_rozpis = inv.id
    INNER JOIN rozpocet_polozka pol ON pol.id_hierarchie = rozpadlici.id 
        AND pol."Název" = pd."Název subjektu"
    INNER JOIN ciselnik_kombinace_verejne_podpory kvpo ON inv.id_verejnapodpora = kvpo.id
    INNER JOIN verejna_podpora vpo ON vpo.id_verejnapodpora = kvpo.id 
        AND vpo.id_projekt = pd.id 
        AND vpo.id_nositel = pd.subjekt_id
    INNER JOIN pomery_financovani pf ON pf.id_nositelpompf = vpo.id 
        AND pf.id_zdrojfin = 415432
),
agregace AS (
    SELECT 
        "Registrační číslo projektu",
        SUM(CASE 
            WHEN inv = 1 AND id_kategorieregionu IN (283463, 283468) 
            THEN pomer * castka / 100
            ELSE 0 
        END) AS "EU-INV",
        SUM(CASE 
            WHEN inv = 0 AND id_kategorieregionu IN (283463, 283468) 
            THEN pomer * castka / 100
            ELSE 0 
        END) AS "EU-NEINV",
        SUM(CASE WHEN inv = 1 THEN castka ELSE 0 END) AS suma_inv,
        SUM(CASE WHEN inv = 0 THEN castka ELSE 0 END) AS suma_neinv
    FROM detail_data
    GROUP BY "Registrační číslo projektu"
),
pravdive_udaje AS (
    SELECT 
        "Registrační číslo projektu",
        '7' AS "Ukazatel",
        CAST("EU-INV" + "EU-NEINV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7a' AS "Ukazatel",
        CAST("EU-INV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7b' AS "Ukazatel",
        CAST("EU-NEINV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7c' AS "Ukazatel",
        CONCAT(
            CAST(ROUND(CASE WHEN suma_inv > 0 THEN "EU-INV" / suma_inv * 100 ELSE 0 END, 2) AS VARCHAR), 
            '; ', 
            CAST(ROUND(CASE WHEN suma_neinv > 0 THEN "EU-NEINV" / suma_neinv * 100 ELSE 0 END, 2) AS VARCHAR)
        ) AS "Pravdivý rozpis financování projektu"
    FROM agregace
)
-- Finální spojení
SELECT 
    p."Registrační číslo projektu",
    pz.posledni_zop AS "Pořadí ŽoP",
    cuk."Kód" AS "Ukazatel",
    ar."Aktuální rozpis financování projektu",
    pu."Pravdivý rozpis financování projektu",
    rf."Předložené vyúčtování v toto ŽoP" AS "Požadováno příjemcem v této ŽoP",
    rf."Schválené vyúčtování ZS/ŘO v této ŽoP",
    CASE 
        WHEN cuk."Kód" IN ('7', '7a', '7b') THEN 
            rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP"
        WHEN cuk."Kód" = '7c' THEN 
            ROUND(100 * hk7.hodnota_7 / NULLIF(rd."CZV", 0), 2)
        ELSE NULL
    END AS "Aktuální disponibilní alokace projektu včetně této ŽoP",
    sz."Schváleno a proplaceno v této ŽoP" AS "Schváleno a proplaceno za projekt včetně této ŽoP",
    rf."Aktuální zůstatek k proplacení za projekt"
FROM projekt p 
INNER JOIN platba pl ON pl.id_nositelplatby = p.id
INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id 
INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
    ON cuk.id = rf.id_ukazatel 
    AND cuk."Kód" IN ('7','7a','7b','7c')
INNER JOIN posledni_zop_cislo pz 
    ON pz.projekt_id = p.id 
    AND pl."Pořadí finančního plánu" = pz.posledni_zop
LEFT JOIN starsi_zop sz 
    ON sz."Registrační číslo projektu" = p."Registrační číslo projektu" 
    AND sz."Kód" = cuk."Kód"
LEFT JOIN aktualni_rozpis ar
    ON ar."Registrační číslo projektu" = p."Registrační číslo projektu"
    AND ar."Ukazatel" = cuk."Kód"
LEFT JOIN rozpis_data rd
    ON rd."Registrační číslo projektu" = p."Registrační číslo projektu"
LEFT JOIN hodnoty_kod_7 hk7
    ON hk7."Registrační číslo projektu" = p."Registrační číslo projektu"
LEFT JOIN pravdive_udaje pu
    ON pu."Registrační číslo projektu" = p."Registrační číslo projektu"
    AND pu."Ukazatel" = cuk."Kód"
WHERE p."Registrační číslo projektu" IN (
    'CZ.01.01.01/08/23_036/0005283',
    'CZ.01.01.01/08/23_036/0005308',
    'CZ.01.01.01/08/23_036/0005174'
)
ORDER BY 
    p."Registrační číslo projektu", 
    CASE cuk."Kód"
        WHEN '7' THEN 1
        WHEN '7a' THEN 2
        WHEN '7b' THEN 3
        WHEN '7c' THEN 4
    END;



---------------------------------------- optimalizované spojení dotazů ------------------------------

WITH 
-- Jednotná filtrace projektů
projekty_filter AS (
    SELECT DISTINCT id, "Registrační číslo projektu"
    FROM projekt
    WHERE -- (id_vyzva = 135563128  -- výzva s rozpadem položek rozpočtu na partnery, PoC 036
	  "Registrační číslo projektu" IN (
	  'CZ.01.01.01/08/23_036/0005283',
	  -- 'CZ.01.01.01/08/23_036/0005308',
	  -- 'CZ.01.01.01/08/23_036/0005174'
	  'CZ.01.01.01/05/22_004/0002656',
	  -- 'CZ.01.01.01/05/22_004/0001267',
	  -- 'CZ.01.01.01/05/22_004/0003502'
	  )
),
-- Základní agregace pro všechny ŽoP
base_data AS (
    SELECT 
        SUM(rf."Schválené vyúčtování ZS/ŘO v této ŽoP") AS suma,
        cuk."Kód",
        p.id AS projekt_id,
        p."Registrační číslo projektu",
        MAX(pl."Pořadí finančního plánu") AS posledni_zop
    FROM projekty_filter p
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id
    INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
    INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
        ON cuk.id = rf.id_ukazatel 
        AND cuk."Kód" IN ('1','7','7a','7b')
    GROUP BY cuk."Kód", p.id, p."Registrační číslo projektu"
),
-- Sloučený výpočet pro starší ŽoP včetně 7c
starsi_zop AS (
    SELECT 
        bd.suma AS "Schváleno a proplaceno v této ŽoP",
        bd."Kód",
        bd.projekt_id,
        bd."Registrační číslo projektu",
        bd.posledni_zop
    FROM base_data bd
    WHERE bd."Kód" IN ('7','7a','7b')
    
    UNION ALL
    
    SELECT 
        ROUND(100 * b7.suma / NULLIF(b1.suma, 0), 2) AS "Schváleno a proplaceno v této ŽoP",
        '7c' AS "Kód",
        b7.projekt_id,
        b7."Registrační číslo projektu",
        b7.posledni_zop
    FROM base_data b7
    INNER JOIN base_data b1 
        ON b7.projekt_id = b1.projekt_id 
        AND b7."Kód" = '7' 
        AND b1."Kód" = '1'
),
-- Hodnoty pro kód 7 (pro výpočet 7c)
hodnoty_kod_7 AS (
    SELECT 
        p."Registrační číslo projektu",
        rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP" AS hodnota_7
    FROM projekty_filter p
    INNER JOIN starsi_zop sz ON sz.projekt_id = p.id AND sz."Kód" = '7'
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id 
        AND pl."Pořadí finančního plánu" = sz.posledni_zop
    INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
    INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
        ON cuk.id = rf.id_ukazatel AND cuk."Kód" = '7'
),
-- Data pro rozpis financování
rozpis_data AS (
    SELECT 
        p."Registrační číslo projektu",
        MAX(CASE WHEN pzfinv.id_kategorieregionu IN (283463, 283468) 
                 AND pzfinv."Investice (A)/Neinvestice (N)" = 'A' 
            THEN pzfinv."Příspěvek Unie" END) AS "EU-INV",
        MAX(CASE WHEN pzfinv.id_kategorieregionu IN (283463, 283468) 
                 AND pzfinv."Investice (A)/Neinvestice (N)" = 'N' 
            THEN pzfinv."Příspěvek Unie" END) AS "EU-NEINV",
        pf."Příspěvek Unie" AS "EU",
        pf."Celkové zdroje připadající na způsobilé výdaje" AS "CZV",
        pf."Příspěvek společenství (% veřejných)" AS "PROCENTO"
    FROM projekty_filter p
    INNER JOIN prehled_zdroju_financovani_sckr_investice pzfinv 
        ON pzfinv.id_projekt = p.id 
        AND pzfinv.id_faze = 99991000000050005
    INNER JOIN prehled_zdroju_financovani pf 
        ON pf.id_projekt = p.id 
        AND pf.id_faze = 99991000000000005
    GROUP BY p."Registrační číslo projektu", pf."Příspěvek Unie", 
             pf."Celkové zdroje připadající na způsobilé výdaje", 
             pf."Příspěvek společenství (% veřejných)"
),
-- Pravdivá data - optimalizovaná agregace
pravdive_agregace AS (
    SELECT 
        pd."Registrační číslo projektu",
	max(CASE WHEN s.id_typsubjektuedit = 413462 THEN s."Název subjektu"
	     END ) "Příjemce",
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 1 
                 AND pf.id_kategorieregionu IN (283463, 283468) 
            THEN pf."Doporučený poměr financování (%)" * pol."Částka celkem" / 100
            ELSE 0 
        END) AS "EU-INV",
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 0 
                 AND pf.id_kategorieregionu IN (283463, 283468) 
            THEN pf."Doporučený poměr financování (%)" * pol."Částka celkem" / 100
            ELSE 0 
        END) AS "EU-NEINV",
        SUM(CASE WHEN rsp."Investice / Neinvestice" = 1 THEN pol."Částka celkem" ELSE 0 END) AS suma_inv,
        SUM(CASE WHEN rsp."Investice / Neinvestice" = 0 THEN pol."Částka celkem" ELSE 0 END) AS suma_neinv
    FROM projekty_filter pd
    INNER JOIN subjekt s ON s.id_prjgg = pd.id 
        AND s."Neplatný od" IS NULL 
        AND s.id_typsubjektuedit IN (413462, 413467)
    INNER JOIN rozpocet_hlavicka hl ON hl.id_nrozpocet = pd.id 
        AND hl."Aktuální" = 'A'
    INNER JOIN rozpocet_skupina sr ON sr.id = hl.id_skupina
    INNER JOIN rozpocet_skupina_polozka rsp ON rsp.id_predpis = sr.id
        AND rsp."Rozpad položky pro partnery s finančním příspěvkem" = 'A'
        AND rsp."Listová" = 'A'
        AND rsp."Platnost" = 'A'
    INNER JOIN rozpocet_polozka rozpadlici ON rozpadlici.id_hlavicka = hl.id 
        AND rozpadlici.id_rozpis = rsp.id
    INNER JOIN rozpocet_polozka pol ON pol.id_hierarchie = rozpadlici.id 
        AND pol."Název" = s."Název subjektu"
    INNER JOIN ciselnik_kombinace_verejne_podpory kvpo ON rsp.id_verejnapodpora = kvpo.id
    INNER JOIN verejna_podpora vpo ON vpo.id_verejnapodpora = kvpo.id 
        AND vpo.id_projekt = pd.id 
        AND vpo.id_nositel = s.id
    INNER JOIN pomery_financovani pf ON pf.id_nositelpompf = vpo.id 
        AND pf.id_zdrojfin = 415432
    GROUP BY pd."Registrační číslo projektu"
),
-- Transformace pravdivých dat na ukazatele
pravdive_udaje AS (
    SELECT 
        "Registrační číslo projektu",
        '7' AS "Ukazatel",
        CAST("EU-INV" + "EU-NEINV" AS VARCHAR) ASNEINVvdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7a' AS "Ukazatel",
        CAST("EU-INV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7b' AS "Ukazatel",
        CAST("EU-NEINV" AS VARCHAR) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
    
    UNION ALL
    
    SELECT 
        "Registrační číslo projektu",
        '7c' AS "Ukazatel",
        CONCAT(
            CAST(ROUND(CASE WHEN suma_inv > 0 THEN "EU-INV" / suma_inv * 100 ELSE 0 END, 2) AS VARCHAR),
            '; ',
            CAST(ROUND(CASE WHEN suma_neinv > 0 THEN "EU-NEINV" / suma_neinv * 100 ELSE 0 END, 2) AS VARCHAR)
        ) AS "Pravdivý rozpis financování projektu"
    FROM pravdive_agregace
)

-- Finální dotaz
SELECT pa."Příjemce",
       p."Registrační číslo projektu",
    sz.posledni_zop AS "Pořadí ŽoP",
    wpl."Kód" "Stav ŽoP",
    pl."Závěrečná platba"  ,
    
    cuk."Kód" AS "Ukazatel",
    -- Aktuální rozpis
    CASE cuk."Kód"
        WHEN '7' THEN rd."EU"
        WHEN '7a' THEN rd."EU-INV"
        WHEN '7b' THEN rd."EU-NEINV"
        WHEN '7c' THEN rd."PROCENTO"
    END AS "Aktuální rozpis financování projektu",
    pu."Pravdivý rozpis financování projektu",
    rf."Předložené vyúčtování v toto ŽoP" AS "Požadováno příjemcem v této ŽoP",
    rf."Schválené vyúčtování ZS/ŘO v této ŽoP",
    -- Disponibilní alokace
    CASE 
        WHEN cuk."Kód" IN ('7', '7a', '7b') THEN 
            rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP"
        WHEN cuk."Kód" = '7c' THEN 
            ROUND(100 * hk7.hodnota_7 / NULLIF(rd."CZV", 0), 2)
    END AS "Aktuální disponibilní alokace projektu včetně této ŽoP",
    sz."Schváleno a proplaceno v této ŽoP" AS "Schváleno a proplaceno za projekt včetně této ŽoP",
    rf."Aktuální zůstatek k proplacení za projekt"

FROM projekty_filter p
INNER JOIN starsi_zop sz ON sz.projekt_id = p.id
INNER JOIN platba pl ON pl.id_nositelplatby = p.id
    AND pl."Pořadí finančního plánu" = sz.posledni_zop
INNER JOIN ciselnik_stav_workflow wpl ON pl.id_wfstav = wpl.id   
INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
    ON cuk.id = rf.id_ukazatel 
    AND cuk."Kód" = sz."Kód"
INNER JOIN rozpis_data rd 
    ON rd."Registrační číslo projektu" = p."Registrační číslo projektu"
INNER JOIN pravdive_udaje pu
    ON pu."Registrační číslo projektu" = p."Registrační číslo projektu"
    AND pu."Ukazatel" = cuk."Kód"
INNER JOIN hodnoty_kod_7 hk7
    ON hk7."Registrační číslo projektu" = p."Registrační číslo projektu"
--- tato vazba se dá ostranit 
INNER JOIN pravdive_agregace pa ON pa."Registrační číslo projektu" = p."Registrační číslo projektu"

ORDER BY 
    p."Registrační číslo projektu",
