---- Partnerství - bez VPo------



WITH 
-- Jednotná filtrace projektů
projekty_filter AS (
    SELECT DISTINCT id, "Registrační číslo projektu" , id_vyzva
    FROM projekt
    WHERE id_vyzva IN ('19010599','282784090','65065676','49964870','80317532','204013035','216308699','118450316','22521393','49882939','122658402','79828975','139638219','369654304','80158052','19421537','20636911','211844942','49893547','19009827','118461981','135563128')
    AND "Registrační číslo projektu" = 'CZ.01.01.01/06/23_014/0001378'
),
-- Základní agregace pro všechny ŽoP
base_data AS (
    SELECT 
        SUM(rf."Schválené vyúčtování ZS/ŘO v této ŽoP") AS suma,
        cuk."Kód",
        p.id AS projekt_id,
        p."Registrační číslo projektu",
        MAX(pl."Pořadí finančního plánu") AS posledni_zop,
        MAX(pl.id) AS platba_id  -- přidáváme platba.id
    FROM projekty_filter p
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id
    INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
    INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
        ON cuk.id = rf.id_ukazatel 
        AND cuk."Kód" IN ('1','7','7a','7b')
    GROUP BY cuk."Kód", p.id, p."Registrační číslo projektu"
),
-- Sloučený výpočet pro starší ŽoP včetně 7c
starsi_zop AS (
    SELECT 
        bd.suma AS "Schváleno a proplaceno v této ŽoP",
        bd."Kód",
        bd.projekt_id,
        bd."Registrační číslo projektu",
        bd.posledni_zop,
        bd.platba_id
    FROM base_data bd
    WHERE bd."Kód" IN ('7','7a','7b')
    
    UNION ALL
    
    SELECT 
        ROUND(100 * b7.suma / NULLIF(b1.suma, 0), 2) AS "Schváleno a proplaceno v této ŽoP",
        '7c' AS "Kód",
        b7.projekt_id,
        b7."Registrační číslo projektu",
        b7.posledni_zop,
        b7.platba_id
    FROM base_data b7
    INNER JOIN base_data b1 
        ON b7.projekt_id = b1.projekt_id 
        AND b7."Kód" = '7' 
        AND b1."Kód" = '1'
),
-- Hodnoty pro kód 7 (pro výpočet 7c)
hodnoty_kod_7 AS (
    SELECT 
        p."Registrační číslo projektu",
        rf."Aktuální zůstatek k proplacení za projekt" + sz."Schváleno a proplaceno v této ŽoP" AS hodnota_7
    FROM projekty_filter p
    INNER JOIN starsi_zop sz ON sz.projekt_id = p.id AND sz."Kód" = '7'
    INNER JOIN platba pl ON pl.id_nositelplatby = p.id 
        AND pl."Pořadí finančního plánu" = sz.posledni_zop
    INNER JOIN rozpis_financovani rf ON rf.id_platba = pl.id
    INNER JOIN ciselnik_ukazatel_rozpis_financovani cuk 
        ON cuk.id = rf.id_ukazatel AND cuk."Kód" = '7'
),
-- Data pro rozpis financování
rozpis_data AS (
    SELECT 
        p."Registrační číslo projektu",
        MAX(CASE WHEN pzfinv.id_kategorieregionu IN (283463, 283468) 
                 AND pzfinv."Investice (A)/Neinvestice (N)" = 'A' 
            THEN pzfinv."Příspěvek Unie" END) AS "EU-INV",
        MAX(CASE WHEN pzfinv.id_kategorieregionu IN (283463, 283468) 
                 AND pzfinv."Investice (A)/Neinvestice (N)" = 'N' 
            THEN pzfinv."Příspěvek Unie" END) AS "EU-NEINV",
        pf."Příspěvek Unie" AS "EU",
        pf."Celkové zdroje připadající na způsobilé výdaje" AS "CZV",
        pf."Příspěvek společenství (% veřejných)" AS "PROCENTO"
    FROM projekty_filter p
    INNER JOIN prehled_zdroju_financovani_sckr_investice pzfinv 
        ON pzfinv.id_projekt = p.id 
        AND pzfinv.id_faze = 99991000000050005
    INNER JOIN prehled_zdroju_financovani pf 
        ON pf.id_projekt = p.id 
        AND pf.id_faze = 99991000000000005
    GROUP BY p."Registrační číslo projektu", pf."Příspěvek Unie", 
             pf."Celkové zdroje připadající na způsobilé výdaje", 
             pf."Příspěvek společenství (% veřejných)"
)


    SELECT 
        pd."Registrační číslo projektu",
        pd.id AS projekt_id,  -- přidáváme projekt.id
        MAX(CASE WHEN s.id_typsubjektuedit = 413462 THEN s."Název subjektu" END) "Příjemce",
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 1 
                 AND pf.id_kategorieregionu IN (283463, 283468) 
            THEN pf."Doporučený poměr financování (%)" * COALESCE(pol."Částka celkem", pol_direct."Částka celkem") / 100
            ELSE 0 
        END) AS "EU-INV",
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 0 
                 AND pf.id_kategorieregionu IN (283463, 283468) 
            THEN pf."Doporučený poměr financování (%)" * COALESCE(pol."Částka celkem", pol_direct."Částka celkem") / 100
            ELSE 0 
        END) AS "EU-NEINV",
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 1 
            THEN COALESCE(pol."Částka celkem", pol_direct."Částka celkem") 
            ELSE 0 
        END) AS suma_inv,
        SUM(CASE 
            WHEN rsp."Investice / Neinvestice" = 0 
            THEN COALESCE(pol."Částka celkem", pol_direct."Částka celkem") 
            ELSE 0 
        END) AS suma_neinv
    FROM projekty_filter pd
    INNER JOIN subjekt s ON s.id_prjgg = pd.id 
        AND s."Neplatný od" IS NULL 
        AND s.id_typsubjektuedit IN (413462, 413467)
    INNER JOIN rozpocet_hlavicka hl ON hl.id_nrozpocet = pd.id 
        AND hl."Aktuální" = 'A'
    INNER JOIN rozpocet_skupina sr ON sr.id = hl.id_skupina
    INNER JOIN rozpocet_skupina_polozka rsp ON rsp.id_predpis = sr.id
        AND rsp."Listová" = 'A'
        AND rsp."Platnost" = 'A'
    LEFT JOIN rozpocet_polozka rozpadlici ON rozpadlici.id_hlavicka = hl.id 
        AND rozpadlici.id_rozpis = rsp.id
        AND rsp."Rozpad položky pro partnery s finančním příspěvkem" = 'A'
    LEFT JOIN rozpocet_polozka pol ON pol.id_hierarchie = rozpadlici.id 
        AND pol."Název" = s."Název subjektu"
    LEFT JOIN rozpocet_polozka pol_direct ON pol_direct.id_hlavicka = hl.id
        AND pol_direct.id_rozpis = rsp.id
        AND (rsp."Rozpad položky pro partnery s finančním příspěvkem" IS NULL 
             OR rsp."Rozpad položky pro partnery s finančním příspěvkem" != 'A')
    INNER JOIN ciselnik_kombinace_verejne_podpory kvpo ON rsp.id_verejnapodpora = kvpo.id
    INNER JOIN verejna_podpora vpo ON vpo.id_verejnapodpora = kvpo.id 
        AND vpo.id_projekt = pd.id 
        AND vpo.id_nositel = s.id
    INNER JOIN pomery_financovani pf ON pf.id_nositelpompf = vpo.id 
        AND pf.id_zdrojfin = 415432
    WHERE (pol.id IS NOT NULL OR pol_direct.id IS NOT NULL)
    GROUP BY pd."Registrační číslo projektu", pd.id


