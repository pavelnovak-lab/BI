-------------------------------- Pravdivá data z projektu ------------------------------

WITH 
-- Předfiltrování položek rozpočtu
inv_polozky AS (
    SELECT 
        id,
        id_verejnapodpora,
        id_predpis,
        "Investice / Neinvestice" AS inv
    FROM rozpocet_skupina_polozka
    WHERE "Rozpad položky pro partnery s finančním příspěvkem" = 'A'
        AND "Listová" = 'A'
        AND "Platnost" = 'A'
),
-- Předpočítání základních dat projektu
projekt_data AS (
    SELECT 
        p.id,
        p."Registrační číslo projektu",
        s.id AS subjekt_id,
        s."Název subjektu",
        hl.id AS hlavicka_id,
        hl.id_skupina
    FROM projekt p
    INNER JOIN subjekt s ON s.id_prjgg = p.id 
        AND s."Neplatný od" IS NULL 
        AND s.id_typsubjektuedit IN (413462, 413467)
    INNER JOIN rozpocet_hlavicka hl ON hl.id_nrozpocet = p.id 
        AND hl."Aktuální" = 'A'
    WHERE p."Registrační číslo projektu" IN (
    'CZ.01.01.01/08/23_036/0005283',
    'CZ.01.01.01/08/23_036/0005308',
    'CZ.01.01.01/08/23_036/0005174'
    )
    
),
-- Předpočítání dat pro agregaci
detail_data AS (
    SELECT 
        pd."Registrační číslo projektu",
        inv.inv,
        pf.id_kategorieregionu,
        pf."Doporučený poměr financování (%)" AS pomer,
        pol."Částka celkem" AS castka
    FROM projekt_data pd
    INNER JOIN rozpocet_skupina sr ON sr.id = pd.id_skupina
    LEFT JOIN inv_polozky inv ON inv.id_predpis = sr.id
    INNER JOIN rozpocet_polozka rozpadlici ON rozpadlici.id_hlavicka = pd.hlavicka_id 
        AND rozpadlici.id_rozpis = inv.id
    INNER JOIN rozpocet_polozka pol ON pol.id_hierarchie = rozpadlici.id 
        AND pol."Název" = pd."Název subjektu"
    INNER JOIN ciselnik_kombinace_verejne_podpory kvpo ON inv.id_verejnapodpora = kvpo.id
    INNER JOIN verejna_podpora vpo ON vpo.id_verejnapodpora = kvpo.id 
        AND vpo.id_projekt = pd.id 
        AND vpo.id_nositel = pd.subjekt_id
    INNER JOIN pomery_financovani pf ON pf.id_nositelpompf = vpo.id 
        AND pf.id_zdrojfin = 415432
),
-- Finální agregace s předpočítanými hodnotami
agregace AS (
    SELECT 
        "Registrační číslo projektu",
        
        -- EU-INV (inv = 1)
        SUM(CASE 
            WHEN inv = 1 AND id_kategorieregionu IN (283463, 283468) 
            THEN pomer * castka / 100
            ELSE 0 
        END) AS "EU-INV",
        
        -- EU-NEINV (inv = 0)
        SUM(CASE 
            WHEN inv = 0 AND id_kategorieregionu IN (283463, 283468) 
            THEN pomer * castka / 100
            ELSE 0 
        END) AS "EU-NEINV",
        
        -- Pomocné součty pro výpočet procent
        SUM(CASE WHEN inv = 0 THEN castka ELSE 0 END) AS suma_inv,
        SUM(CASE WHEN inv = 1 THEN castka ELSE 0 END) AS suma_neinv
        
    FROM detail_data
    GROUP BY "Registrační číslo projektu"
)
-- Výstup ve 4 řádcích - zpět k původnímu UNION ALL přístupu
SELECT 
    "Registrační číslo projektu",
    CAST("EU-INV" + "EU-NEINV" AS VARCHAR) AS "Informace z projektu",
    1 AS poradi
FROM agregace

UNION ALL

SELECT 
    "Registrační číslo projektu",
    CAST("EU-INV" AS VARCHAR) AS "Informace z projektu",
    2 AS poradi
FROM agregace

UNION ALL

SELECT 
    "Registrační číslo projektu",
    CAST("EU-NEINV" AS VARCHAR) AS "Informace z projektu",
    3 AS poradi
FROM agregace

UNION ALL

SELECT 
    "Registrační číslo projektu",
    CONCAT(
        CAST(ROUND(CASE WHEN suma_inv > 0 THEN "EU-INV" / suma_inv * 100 ELSE 0 END, 2) AS VARCHAR), 
        '; ', 
        CAST(ROUND(CASE WHEN suma_neinv > 0 THEN "EU-NEINV" / suma_neinv * 100 ELSE 0 END, 2) AS VARCHAR)
    ) AS "Informace z projektu",
    4 AS poradi
FROM agregace

ORDER BY poradi;



