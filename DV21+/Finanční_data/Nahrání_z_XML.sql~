 SELECT op.nazev AS "Opatření",
           count(xml_ne.id) AS "Počet  ŽoP doklady ručně",
           count(xml_ano.id) AS "Počet ŽoP s doklady z XML",
           ((count(xml_ano.id) /(count(xml_ne.id) + count(xml_ne.id))) * 100) AS procento
    FROM (
             (
                 (
                     (
                         (
                             (projekt AS p INNER JOIN vyzva AS v ON v.id = p.id_vyzva)
                             INNER JOIN vyzva_hierarchie AS vh
                                 ON vh.id_vyzva = v.id
                         )
                         INNER JOIN v_rav_umshisc AS op
                             ON op.id = vh.id_speccil
                     )
                     INNER JOIN platba AS pl
                         ON pl.id_nositelplatby = p.id
                 )
                 INNER JOIN ciselnik_stav_workflow AS w
                     ON pl.id_wfstav = w.id
             )
             LEFT OUTER JOIN (
                 SELECT pl.id,
                        pl."Číslo platby"
                 FROM platba pl
                 WHERE EXISTS (
                           SELECT 1
                           FROM soupiska_doklad
                           WHERE (
                                     id_platba = pl.id
                                     AND (
                                         "ID z externího systému" > 0
                                         OR "ID z externího systému" IS NOT NULL
                                     )
                                 )
                       )
             ) AS xml_ano
                 ON xml_ano.id = pl.id
         )
         LEFT OUTER JOIN (
             SELECT pl.id,
                    pl."Číslo platby"
             FROM platba pl
             WHERE NOT EXISTS (
                       SELECT 1
                       FROM soupiska_doklad
                       WHERE (
                                 id_platba = pl.id
                                 AND ("ID z externího systému" > 0 OR "ID z externího systému" IS NOT NULL)
                             )
                   )
         ) AS xml_ne
             ON xml_ne.id = pl.id
    WHERE pl."Číslo platby" IS NOT NULL
    GROUP BY op.nazev;
