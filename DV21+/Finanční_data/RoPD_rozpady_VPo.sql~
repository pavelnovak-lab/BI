-- Řádek pro Rámec VVI, tedy bez VPo
SELECT 'Rámec pro podporu VVI' AS "Režim podpory",
       NULL AS "Článek GBER",
       bezvpo.zv AS "Způsobilé výdaje",
       bezvpo."EU podíl maximálně" AS "EU podíl maximálně",
       100 - bezvpo."EU podíl maximálně" AS "Vlastní podíl minimálně"
FROM v_rav_umzprojekt p
INNER JOIN (
    SELECT p.id,
    	   ramec.zv,
           SUM(CASE WHEN pf.id_kategorieregionu = 283463 THEN pf.pomerfin * kr.less  --MRR
                    WHEN pf.id_kategorieregionu = 283468 THEN pf.pomerfin * kr.trans -- PR
               END) / 100 AS "EU podíl maximálně"
    FROM projekt p
    INNER JOIN vyzva v ON v.id = p.id_vyzva
    INNER JOIN v_rav_umfpomeryhlavicka h ON h.id_nositelpompf = v.id 
    INNER JOIN v_rav_umfpomerfinancovani pf ON h.id = pf.id_hlavicka
    INNER JOIN v_rav_umzprjggsc kr ON kr.id_prjgg = p.id
    INNER JOIN (SELECT sum(pol.castkacelkem) zv ,
    	       	       hl.id_nrozpocet
		FROM v_rav_umfrozhlavicka hl 
    		INNER JOIN v_rav_umfrozpolozky pol ON pol.id_hlavicka = hl.id
		INNER JOIN v_rav_umfrozskupinapol skpol ON skpol.id = pol.id_rozpis 

		WHERE hl.aktualni = 'A'
		AND skpol.id_verejnapodpora < 1
		AND skpol.listova = 'A'
		GROUP BY hl.id_nrozpocet) ramec ON ramec.id_nrozpocet = p.id 
    WHERE h.regionalnipodpora = 'N'
    AND pf.id_zdrojfin IN (415552) -- zdroj EU
    GROUP BY p.id,
    	     ramec.zv
	     ) bezvpo ON bezvpo.id = p.id
WHERE p.kod IN ('CZ.01.01.01/06/23_014/0001360')
AND bezvpo."EU podíl maximálně" IS NOT NULL

ORDER BY  "Režim podpory", SUBSTRING("Článek GBER", 10)



