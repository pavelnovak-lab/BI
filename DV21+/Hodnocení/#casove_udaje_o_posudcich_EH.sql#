-- CREATE or REPLACE view  FOLDER=  AS 

SELECT	tel."Kód uživatele2" "Kód hodnotitele",
 	dep."Adresa uživatele",
	-- p."Registrační číslo projektu" ,
	-- h."Datum schválení" ,
	sum(
	CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2023-12-01 00:00:00')
	     THEN
	     	CASE WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 10000000 then 12
	     	WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 50000000 then 14
	     	WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 100000000 then 16
	     	ELSE 18 END 
	     ELSE 0 END ) "Počet hodin 2023-12", 
	sum(CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2023-12-01 00:00:00') THEN 1 END) AS "Celkem projektů 2023-12",
	sum(CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2023-12-01 00:00:00') THEN pf."Celkové zdroje připadající na způsobilé výdaje" END ) AS "Celkem CZV 2023-12",

	sum(
	CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-02-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00')
	     THEN
	     	CASE WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 10000000 then 12
	     	WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 50000000 then 14
	     	WHEN pf."Celkové zdroje připadající na způsobilé výdaje" < 100000000 then 16
	     	ELSE 18 END 
	     ELSE 0 END ) "Počet hodin 2024-01", 
	sum(CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-02-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00') THEN 1 END) AS "Celkem projektů 2024-01",
	sum(CASE WHEN h."Datum schválení" < to_date('yyyy-MM-dd HH:mm:ss','2024-02-01 00:00:00') AND h."Datum schválení" > to_date('yyyy-MM-dd HH:mm:ss','2024-01-01 00:00:00') THEN pf."Celkové zdroje připadající na způsobilé výdaje" END ) AS "Celkem CZV 2024-01"

FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN prehled_zdroju_financovani pf ON pf.id_projekt = p.id AND pf.id_faze = 99991000000000005 -- aktuální stav
INNER JOIN hodnoceni h ON p.id = h.id_noshodnoceni
INNER JOIN hodnotitel tel ON h.id_hodnotitel = tel.id
INNER JOIN hodnotitel_adresa_depese dep ON dep.id = tel.id

WHERE h."Platný" = 'A'
 -- AND h."Finalizováno" = 'A'
AND tel."Interní hodnotitel" = 'N'
 -- AND tel."Kód uživatele2" in (567) --, 963)
 -- AND h."Datum schválení" is not null 
AND



