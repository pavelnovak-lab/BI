-- CREATE or REPLACE view "tak-novak-posudky-ekonomickeho-hodnoceni-zamitnute-na-vyroku-analytika" FOLDER='/06_Data_models/01_OP_TAK/MPO/novak-pavel/RIS3' AS 


SELECT v."Èíslo výzvy" ,
       v."Název výzvy",
       sk."Název souboru kritérií",
       p."Registraèní èíslo projektu" ,
       w."Kód" "Kód stavu" ,
       st."Popis statutu",
       st."Celkový výsledek - v bodech",
       st."Celkový výrok",
       eh."Celkový výsledek - v bodech" "Celkem bodù v EH" ,
       eh."Popis statutu" "Statut EH"
       -- h."Výsledek (v bodech)",
       -- sum(CASE WHEN h."Finalizováno" = 'A' THEN 1
       -- 	    ELSE 0 END ) "Poèet zalo¾ených posudkù",
       -- sum(CASE WHEN h."Finalizováno" = 'A' THEN 1
       -- 	    ELSE 0 END ) "Poèet finalizovaných posudkù",
       -- sum(CASE WHEN h."Schváleno schvalovatelem" = 'A' THEN 1
       -- 	    ELSE 0 END) "Poèet schválených posudkù"
              
	      
FROM vyzva v 
INNER JOIN soubor_kriterii_vyzvy skv ON skv.id_vyzva = v.id
INNER JOIN soubor_kriterii sk ON sk.id = skv.id_souborkrit
INNER JOIN projekt p ON p.id_vyzva = v.id AND p."Registraèní èíslo projektu" is not null 
INNER JOIN hodnoceni h ON h.id_noshodnoceni = p.id AND h.id_souborkrit = sk.id AND h.id_hodnotitel > 0 -- AND h.id_statushodn = 488649 -- nevyhovìl 
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  
LEFT JOIN (SELECT sh."Popis statutu",
     	  	  sh."Celkový výsledek - v bodech",
		  c."Název" "Celkový výrok",
  			sh.id_noshodnoceni
     	   FROM hodnoceni_status sh 
 	   LEFT JOIN ciselnik_status_hodnoceni c ON c.id = sh.id_statushodn
	   WHERE sh.id_krokvechodn = 488854 ) st ON st.id_noshodnoceni = p.id
LEFT JOIN (SELECT sh."Popis statutu",
     	  	  sh."Celkový výsledek - v bodech",
		  c."Název" "Celkový výrok",
  			sh.id_noshodnoceni
     	   FROM hodnoceni_status sh 
 	   LEFT JOIN ciselnik_status_hodnoceni c ON c.id = sh.id_statushodn
	   WHERE sh.id_krokvechodn = 488849 ) eh ON eh.id_noshodnoceni = p.id


WHERE skv.id_souborkrit IN (21177955, 163054420) -- sk s jedním bodem Technologie 4.0
AND p."Registraèní èíslo projektu" IN ('CZ.01.01.01/01/22_002/0000302','CZ.01.01.01/01/22_002/0000616','CZ.01.01.01/01/22_002/0000940','CZ.01.01.01/01/22_002/0001050','CZ.01.01.01/03/23_024/0001902','CZ.01.01.01/03/23_024/0002592','CZ.01.01.01/03/23_024/0002698','CZ.01.01.01/03/23_024/0002786','CZ.01.01.01/03/23_024/0002851','CZ.01.01.01/03/23_024/0002864','CZ.01.01.02/01/23_039/0003781','CZ.01.01.02/01/23_039/0003836')
