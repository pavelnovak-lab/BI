       kr."Název" ,
       kr."Kód" ,
       p30.*,
       tel.*

FROM  projekt p
INNER JOIN hodnoceni h ON h.id_noshodnoceni = p.id 
INNER JOIN hodnota_kriteria kr ON h.id = kr.id_hodnoceni
INNER JOIN hodnota_kriteria_pp30 p30 ON p30.id = kr.id
