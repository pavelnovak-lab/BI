SELECT p."Registrační číslo projektu",
       w."Kód" "Kód stavu" ,
       count(s.id) "Počet partnerů"
FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  
INNER JOIN subjekt s ON s.id_prjgg = p.id AND s.id_typsubjektuedit = 413467 -- žadatel 


WHERE p."Registrační číslo projektu" is not null
AND v."Číslo výzvy" = '01_22_002'
AND exists (SELECT 1
    	       	FROM subjekt
		WHERE id_prjgg = p.id
		AND id_typsubjektuedit = 413467 -- partner s finančním příspěvkemn
		)


AND w."Kód" REGEXP_LIKE 'PP[3]1'

GROUP BY p."Registrační číslo projektu" ,
      	 w."Kód"

ORDER BY "Počet partnerů" desc