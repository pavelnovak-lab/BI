/* Najdi, měsíce s přepínáním */
SELECT FORMATDATE('YY-MM', hs."Datum změny") mesic ,
	p.id
FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN historie_stavu hs on hs.nositelid = p.id
AND p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000418'
GROUP BY p.id, mesic
----------------------------------------
/* Měsíce s duplicitním přepnutím */
SELECT  FORMATDATE('YY-MM', hs."Datum změny") ,
 	-- count(FORMATDATE('YY-MM', hs."Datum změny")) ,
	p.id
FROM projekt p
INNER JOIN historie_stavu hs on hs.nositelid = p.id
WHERE p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000418'
GROUP BY FORMATDATE('YY-MM', hs."Datum změny"), p.id
HAVING count(FORMATDATE('YY-MM', hs."Datum změny")) > 1
----------------------------------------
/* Vypiš jen poslední hodnoty u duplicit */
SELECT d.mesic
       max(hs."Datum změny") posledni_cas
FROM projekt p
INNER JOIN historie_stavu hs on hs.nositelid = p.id
INNER JOIN
      (SELECT FORMATDATE('YY-MM', hs."Datum změny") mesic ,
	      -- count(FORMATDATE('YY-MM', hs."Datum změny")) ,
	      p.id
      FROM projekt p
      INNER JOIN historie_stavu hs on hs.nositelid = p.id
      WHERE p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000418'
      GROUP BY FORMATDATE('YY-MM', hs."Datum změny"), p.id
      HAVING count(FORMATDATE('YY-MM', hs."Datum změny")) > 1) d ON d.id = p.id AND d.mesic = FORMATDATE('YY-MM', hs."Datum změny") 
GROUP BY d.mesic

/* Najdu měsíce, kde se nic nedělo - jsou u nich nuly */
WITH prepnuti AS (
SELECT FORMATDATE('YY-MM', hs."Datum změny") mesic ,
	p.id
FROM projekt p
INNER JOIN historie_stavu hs on hs.nositelid = p.id
AND p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000418'
GROUP BY p.id, mesic
)

SELECT max(CASE WHEN '23-01' IN pr.mesic then 1 ELSE 0 END ) AS "23-01",
       max(case WHEN '23-02' IN pr.mesic then 1 ELSE 0 END ) AS "23-02" ,
       max(CASE WHEN '23-03' IN pr.mesic then 1 ELSE 0 END ) AS "23-03",
