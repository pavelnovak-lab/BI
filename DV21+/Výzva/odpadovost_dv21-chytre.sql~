
/* wiev obsahuje řádky projektů a ve sloupcích jsou jejich stavy v daném měsíci */
with sm AS
(SELECT	p."Registrační číslo projektu" ,
	min(CASE WHEN hs.mesic = '22-09' THEN hs.stav
       		WHEN hs.mesic < '22-09' THEN hs.stav
 		END  ) AS "Stav 22-09",

	min(CASE WHEN hs.mesic = '22-10' THEN hs.stav
       		WHEN hs.mesic < '22-10' THEN hs.stav
 		END  ) AS "Stav 22-10",

	min(CASE WHEN hs.mesic = '22-11' THEN hs.stav
       		WHEN hs.mesic < '22-11' THEN hs.stav
 		END  ) AS "Stav 22-11",

	min(CASE WHEN hs.mesic = '22-12' THEN hs.stav
       		WHEN hs.mesic < '22-12' THEN hs.stav
 		END  ) AS "Stav 22-12",

	min(CASE WHEN hs.mesic = '23-01' THEN hs.stav
       		WHEN hs.mesic < '23-01' THEN hs.stav
 		END  ) AS "Stav 23-01",

	min(CASE WHEN hs.mesic = '23-02' THEN hs.stav
       		WHEN hs.mesic < '23-02' THEN hs.stav
 		END  ) AS "Stav 23-02",

	min(CASE WHEN hs.mesic = '23-03' THEN hs.stav
       		WHEN hs.mesic < '23-03' THEN hs.stav
 		END  ) AS "Stav 23-03",

	min(CASE WHEN hs.mesic = '23-04' THEN hs.stav
       		WHEN hs.mesic < '23-04' THEN hs.stav
 		END  ) AS "Stav 23-04",

	min(CASE WHEN hs.mesic = '23-05' THEN hs.stav
       		WHEN hs.mesic < '23-05' THEN hs.stav
 		END  ) AS "Stav 23-05",

	min(CASE WHEN hs.mesic = '23-06' THEN hs.stav
       		WHEN hs.mesic < '23-06' THEN hs.stav
 		END  ) AS "Stav 23-06",

	min(CASE WHEN hs.mesic = '23-07' THEN hs.stav
       		WHEN hs.mesic < '23-07' THEN hs.stav
 		END  ) AS "Stav 23-07",

	min(CASE WHEN hs.mesic = '23-08' THEN hs.stav
       		WHEN hs.mesic < '23-08' THEN hs.stav
 		END  ) AS "Stav 23-08",

	min(CASE WHEN hs.mesic = '23-09' THEN hs.stav
       		WHEN hs.mesic < '23-09' THEN hs.stav
 		END  ) AS "Stav 23-09",

	min(CASE WHEN hs.mesic = '23-10' THEN hs.stav
       		WHEN hs.mesic < '23-10' THEN hs.stav
 		END  ) AS "Stav 23-10",

	min(CASE WHEN hs.mesic = '23-11' THEN hs.stav
       		WHEN hs.mesic < '23-11' THEN hs.stav
 		END  ) AS "Stav 23-11"

FROM 
(SELECT p."Registrační číslo projektu" ,
	w."Kód" AS aktualnistav,
       FORMATDATE('YY-MM', hs."Datum změny") mesic ,
       FORMATDATE('YY-MM', p."Datum změny stavu") poslednidatum,
       MAX(
       CASE WHEN sw."Kód" = 'PU22a' THEN 'PP20'
       	    WHEN sw."Kód" = 'PN22a' OR sw."Kód" = 'PN22b' THEN 'PN22'
 	    WHEN sw."Kód" = 'PN20a' OR sw."Kód" = 'PN20b' THEN 'PN20'
 	    WHEN sw."Kód" = 'PP23a' OR sw."Kód" = 'PP23b' THEN 'PP23'
 	    WHEN sw."Kód" = 'PP25a' OR sw."Kód" = 'PP25b' OR sw."Kód" = 'PU25' OR sw."Kód" = 'PU26' OR sw."Kód" = 'PP26' THEN 'PP25'
       	    WHEN sw."Kód" = 'PN26' THEN 'PN25'
       ELSE sw."Kód" END ) AS stav
FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN historie_stavu hs on hs.nositelid = p.id
INNER JOIN ciselnik_stav_workflow sw on sw.id = hs.id_stavdo
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id

WHERE p."Registrační číslo projektu" is not null
AND v."Číslo výzvy" = '01_22_002'
AND p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000768'

GROUP BY mesic, p."Registrační číslo projektu", poslednidatum, aktualnistav
ORDER BY mesic
) hs 
GROUP BY p."Registrační číslo projektu" 
)

SELECT -- sm."Stav 23-03"
	sum(CASE WHEN sm."Stav 23-03" = 'PP20' THEN 1 END) AS "23-03 PP20",
 	sum(CASE WHEN sm."Stav 23-03" = 'PN20' THEN 1 END) AS "23-03 PN20",
 	sum(CASE WHEN sm."Stav 23-03" = 'PP22' THEN 1 END) AS "23-03 PP22",	
	sum(CASE WHEN sm."Stav 23-03" = 'PN22' THEN 1 END) AS "23-03 PN22",
 	sum(CASE WHEN sm."Stav 23-03" = 'PP23' THEN 1 END) AS "23-03 PP23",
 	sum(CASE WHEN sm."Stav 23-03" = 'PN23' THEN 1 END) AS "23-03 PN23",	
 	sum(CASE WHEN sm."Stav 23-03" = 'PP25' THEN 1 END) AS "23-03 PP25",	       	    
 	sum(CASE WHEN sm."Stav 23-03" = 'PN25' THEN 1 END) AS "23-03 PN25"	       	    
FROM sm

GROUP BY sm."Stav 23-03"





