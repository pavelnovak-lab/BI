/* Pokud neexistuje hodnota v měsíci, najdi poslední měsíci, kde přepnuto bylo, tedy k měsíci přiřadím čas z některého předchozího měsíce. */

select p.id,
       max(FORMATDATE('YY-MM', hs."Datum změny")) mesic
FROM projekt p
INNER JOIN historie_stavu hs on hs.nositelid = p.id

WHERE p."Registrační číslo projektu" is not null
AND p."Registrační číslo projektu" = 'CZ.01.01.01/01/22_002/0000418'
AND  FORMATDATE('YY-MM', hs."Datum změny") < '23-05'



GROUP BY p.id


