       max(CASE WHEN '23-07' IN pr.mesic then 1 ELSE 0 END ) AS "23-07",
       max(CASE WHEN '23-08' IN pr.mesic then 1 ELSE 0 END ) AS "23-08",
       max(CASE WHEN '23-09' IN pr.mesic then 1 ELSE 0 END ) AS "23-09",
       max(CASE WHEN '23-10' IN pr.mesic then 1 ELSE 0 END ) AS "23-10",
       max(CASE WHEN '23-11' IN pr.mesic then 1 ELSE 0 END ) AS "23-11",
       max(CASE WHEN '23-12' IN pr.mesic then 1 ELSE 0 END ) AS "23-12"
       
FROM prepnuti pr

