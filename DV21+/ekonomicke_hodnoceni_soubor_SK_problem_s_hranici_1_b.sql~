       v."Název výzvy" 

from
--vyzva v
--INNER JOIN
v_rav_umvhodnsoubkritvyz sk ON sk.id_vyzva = v.id

where sk.id_souborkrit IN (21177955, 21177955) -- sk s jedním bodem 

----------------------------------------
SELECT v."Èíslo výzvy" ,
       v."Název výzvy",
       vw."Název" "Stav výzvy" ,
       sk."Název souboru kritérií" ,
       max(seh.pocet) "Projektù s EH" ,
       max(pocprj.pocet - seh.pocet) "Projektù bez EH",
       max(pocprj.pocet) "Projektù celkem",
       max(pn.pocet) "Projektù v PN20a,b/PN22"
       -- p."Registraèní èíslo projektu" ,
       -- w."Kód" "Kód stavu" ,
       -- h."Výsledek (v bodech)"
	      
FROM vyzva v
INNER JOIN ciselnik_stav_workflow AS vw ON vw.id = v.id_wfstav
INNER JOIN soubor_kriterii_vyzvy skv ON skv.id_vyzva = v.id
INNER JOIN soubor_kriterii sk ON sk.id = skv.id_souborkrit
INNER JOIN projekt p ON p.id_vyzva = v.id 
-- INNER JOIN hodnoceni h ON h.id_noshodnoceni = p.id AND h.id_souborkrit = sk.id AND h.id_statushodn = 488649 -- nevyhovìl 
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  
LEFT JOIN (SELECT count(h.id) pocet,
     	  	  h.id_noshodnoceni
     	   FROM hodnoceni h
	   -- INNER JOIN projekt p ON p.id_vyzva = v.id AND p."Registraèní èíslo projektu" is not null 
	   -- INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  

	   WHERE h.id_souborkrit IN (21177955, 163054420)
	   AND h."Platný" = 'A'
	   AND h."Finalizováno" = 'A'
	   AND h."Schváleno schvalovatelem" = 'A'
	   GROUP BY h.id_noshodnoceni) seh ON seh.id_noshodnoceni = p.id 
LEFT JOIN (SELECT count(p.id) pocet,
     	  	  p.id_vyzva
	   FROM projekt p 
	   WHERE p."Registraèní èíslo projektu" is not null 
	   GROUP BY p.id_vyzva) pocprj ON pocprj.id_vyzva = v.id
LEFT JOIN (SELECT count(p.id) pocet,
     	  	  p.id_vyzva
	   FROM projekt p 
	   INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  

 	   WHERE p."Registraèní èíslo projektu" is not null
	   AND w."Kód" IN ('PN20b','PN20a','PN22')
	   GROUP BY p.id_vyzva) pn ON pn.id_vyzva = v.id

WHERE v."Èíslo výzvy" IN ('01_24_051', '01_23_039', '01_24_050')
AND skv.id_souborkrit IN (21177955, 163054420) -- sk s jedním bodem ve výroku analytika ratingu
-- AND w."Kód" not like ('PN%')
AND p."Registraèní èíslo projektu" is not null


GROUP BY v."Èíslo výzvy" ,
       v."Název výzvy",
       vw."Název",
       sk."Název souboru kritérií" 
       

ORDER BY v."Èíslo výzvy" 

