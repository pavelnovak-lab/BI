SELECT SUBSTRING(p."Registraèní èíslo projektu",25) "Èíslo projektu",
       s."Název subjektu",
       w.kod "Kód stavu",
       prvni."Vyhovìl",
       prvni."Poèet bodù"
              
FROM projekt p
INNER JOIN v_rav_umscisstavwf w ON w.id = p.id_wfstav
INNER JOIN vyzva v ON v.id = p.id_vyzva
INNER JOIN subjekt s ON s.id_prjgg = p.id AND s.id_typsubjektuedit = 413462
INNER JOIN
( SELECT min(h."Poøadí") "Poøadí posudku",
  	 GROUP_CONCAT(DISTINCT hk."Vyhovìl") "Vyhovìl",	
	 h.id_noshodnoceni,
 	 h."Výsledek (v bodech)" "Poèet bodù"
  FROM hodnoceni h -- ON h.id_noshodnoceni = p.id
  INNER JOIN hodnota_kriteria hk ON hk.id_hodnoceni = h.id AND hk.id_typkriteria = 488954 -- Vyluèovací 488949 Hodnotící

  WHERE h."Platný" = 'A'
  AND h."Finalizováno" = 'A'
  AND h."Schváleno schvalovatelem" = 'A'
  AND h.id_krokvechodn = 488854
  -- AND h.id = 124520646
  AND hk."Relevantní" = 'A'
  AND h."Arbitr" = 'N'

  GROUP BY h.id_noshodnoceni,
 	 h."Výsledek (v bodech)") prvni ON prvni.id_noshodnoceni = p.id 



WHERE p."Registraèní èíslo projektu" = 'CZ.01.01.01/01/22_002/0000744'




