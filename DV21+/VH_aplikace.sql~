WITH prvnidruhy AS (
SELECT min(h."Poøadí") "Prvý poøadí",
       max(h."Poøadí") "Druhý poøadí",
       h.id_noshodnoceni
FROM hodnoceni h -- ON h.id_noshodnoceni = p.id
WHERE h."Platný" = 'A'
AND h."Finalizováno" = 'A'
AND h."Schváleno schvalovatelem" = 'A'
AND h.id_krokvechodn = 488854
-- AND h.id = 124520646
-- AND hk."Relevantní" = 'A'
AND h."Arbitr" = 'N'

GROUP BY h.id_noshodnoceni )

SELECT GROUP_CONCAT(DISTINCT kprvni."Vyhovìl") "První binár",
       GROUP_CONCAT(DISTINCT kdruhy."Vyhovìl") "Druhý binár",	
       prvni."Výsledek (v bodech)" "První bodù",
       druhy."Výsledek (v bodech)" "Druhý bodù" ,
       max(100*abs(bprvni."Poèet bodù"-bdruhy."Poèet bodù")/bprvni."Max. bodù") "Li¹í se o %"
       -- bprvni."Kód",
       -- bprvni."Max. bodù" ,
       -- bprvni."Poèet bodù" "Prvni bodù v kritériu",
       -- bdruhy."Poèet bodù" "Druhý bodù v kritériu"

FROM prvnidruhy pd
INNER JOIN hodnoceni prvni ON prvni.id_noshodnoceni = pd.id_noshodnoceni AND prvni."Poøadí" = pd."Prvý poøadí"
INNER JOIN hodnota_kriteria kprvni ON kprvni.id_hodnoceni = prvni.id AND kprvni.id_typkriteria = 488954 -- AND prvni."Poøadí" = pd."Prvý poøadí" -- Vyluèovací 488949 Hodnotící
INNER JOIN hodnota_kriteria bprvni ON bprvni.id_hodnoceni = prvni.id AND bprvni.id_typkriteria = 488949 --  Hodnotící
LEFT JOIN hodnoceni druhy ON druhy.id_noshodnoceni = pd.id_noshodnoceni AND druhy."Poøadí" = pd."Druhý poøadí"
LEFT JOIN hodnota_kriteria kdruhy ON kdruhy.id_hodnoceni = druhy.id AND kdruhy.id_typkriteria = 488954 -- AND druhy."Poøadí" = pd."Prvý poøadí" -- Vyluèovací 488949 Hodnotící
LEFT JOIN hodnota_kriteria bdruhy ON bdruhy.id_hodnoceni = druhy.id AND bdruhy.id_typkriteria = 488949 AND bdruhy."Kód" = bprvni."Kód"

WHERE pd.id_noshodnoceni = 49944740


GROUP BY prvni."Výsledek (v bodech)" ,
      	 druhy."Výsledek (v bodech)" 
       -- bprvni."Kód",
       -- bprvni."Max. bodù" ,
       -- bprvni."Poèet bodù" ,
       -- bdruhy."Poèet bodù"
      
