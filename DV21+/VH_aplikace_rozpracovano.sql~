-- CREATE or replace view "VH_aplikace_kriteria" FOLDER = '/06_Data_models/01_OP_TAK/MPO/novak-pavel/Hodnoceni' as

WITH
prvnidruhy AS (
SELECT min(h."Poøadí") "Prvý poøadí",
       max(h."Poøadí") "Druhý poøadí",
       h.id_noshodnoceni,
       a."Poøadí" "Poøadí arbitr",
       count(h.id)
FROM hodnoceni h
LEFT JOIN (
     SELECT h."Poøadí",
     	    h.id_noshodnoceni,
	    h.id
     FROM hodnoceni h
     WHERE h."Platný" = 'A'
     AND h."Finalizováno" = 'A'
     AND h."Schváleno schvalovatelem" = 'A'
     AND h.id_krokvechodn = 488854 -- 2. krok VH
     AND h."Arbitr" = 'A' ) a ON a.id_noshodnoceni = h.id_noshodnoceni
WHERE h."Platný" = 'A'
AND h."Finalizováno" = 'A'
AND h."Schváleno schvalovatelem" = 'A'
AND h.id_krokvechodn = 488854 -- 2. krok VH
AND h."Opravný posudek" = 'N'
AND h."Arbitr" = 'N'
-- AND h.id_noshodnoceni = 28619333 -- p."Registraèní èíslo projektu" = 'CZ.01.01.01/01/22_002/0000120' -- má arbitra
GROUP BY h.id_noshodnoceni,
      	 a."Poøadí"
HAVING count(h.id) IN (2,3) /* k ostranìní prj, pouze s jedním platným posudkem */ ),

vylucovaci AS (
SELECT hk.id_hodnoceni,
       -- hk.id_typkriteria,
       -- group_concat(distinct hk."Poèet bodù") "Bodù v nesplnìných komb. kriteriích",
       group_concat(distinct hk."Kód") "Kódy nesplnìných binárù"   ,
       titel."Kód u¾ivatele" "Kód"
FROM projekt p
INNER JOIN hodnoceni h ON h.id_noshodnoceni = p.id 
INNER JOIN hodnota_kriteria hk ON hk.id_hodnoceni = h.id 
INNER JOIN hodnotitel titel ON titel.id = h.id_hodnotitel

WHERE p.id_prioritniosa = 259860 /* Aplikace a spol. */
AND h."Platný" = 'A'
AND h."Finalizováno" = 'A'
AND h."Schváleno schvalovatelem" = 'A'
AND h.id_krokvechodn = 488854
AND hk."Vyhovìl" = 'N'
AND hk.id_typkriteria IN (488954,488959) --       (488954) -- , 278230) /* binár nebo kombinované */

AND p.id_vyzva = 18995356 -- VYHODIT PAK VEN!!!!!
GROUP BY hk.id_hodnoceni, "Kód" ), 

kriteria AS (
SELECT prvni."Výsledek (v bodech)" "První celkem bodù",
       druhy."Výsledek (v bodech)" "Druhý celkem bodù" ,
       arb."Výsledek (v bodech)" "Arbitr bodù" ,
       kprvni."Poèet bodù" "H1 bodù",
       kprvni."Vyhovìl" "H1 vyhovìl",
       kprvni."Max. bodù",
       kprvni.id_typkriteria,
       kprvni."Kód",
       kprvni."Název",
       kdruhy."Poèet bodù" "H2 bodù",
       kdruhy."Vyhovìl" "H2 Vyhovìl",
       karb."Poèet bodù" "Arb bodù",
       karb."Vyhovìl" "Arb Vyhovìl",
       prvni.id "id_prvnihodn",
       druhy.id "id_druhehodn",
       arb.id "id_arbhodn",
       prvni.id_noshodnoceni ,
       CASE
	 WHEN kprvni."Max. bodù" IN (0, NULL) THEN 0
         ELSE 100*abs(kprvni."Poèet bodù"-kdruhy."Poèet bodù")/kprvni."Max. bodù"
       END AS  "Li¹í se o %"
       -- CASE
       -- 	 WHEN kprvni."Vyhovìl" is null THEN NULL
       -- 	 WHEN kprvni."Vyhovìl" is not null AND (kprvni."Vyhovìl"=kdruhy."Vyhovìl") AND  (kprvni."Vyhovìl"='A') THEN 'AA'
       -- 	 WHEN kprvni."Vyhovìl" is not null AND (kprvni."Vyhovìl"=kdruhy."Vyhovìl") AND  (kprvni."Vyhovìl"='N') THEN 'NN'
       -- 	 WHEN kprvni."Vyhovìl" is not null AND kprvni."Vyhovìl"='A' AND kdruhy."Vyhovìl"='N' THEN 'AN'
       -- 	 WHEN kprvni."Vyhovìl" is not null AND kprvni."Vyhovìl"='N' AND kdruhy."Vyhovìl"='A' THEN 'NA'
       -- 	 ELSE NULL
       -- END AS  "Bináry proti sobì" 
FROM prvnidruhy pd
INNER JOIN hodnoceni prvni ON prvni.id_noshodnoceni = pd.id_noshodnoceni AND prvni."Poøadí" = pd."Prvý poøadí" AND prvni.id_krokvechodn = 488854
INNER JOIN hodnota_kriteria kprvni ON kprvni.id_hodnoceni = prvni.id AND kprvni.id_typkriteria in (488954, 488949)
INNER JOIN hodnoceni druhy ON druhy.id_noshodnoceni = pd.id_noshodnoceni AND druhy."Poøadí" = pd."Druhý poøadí" AND druhy.id_krokvechodn = 488854
INNER JOIN hodnota_kriteria kdruhy ON kdruhy.id_hodnoceni = druhy.id AND kdruhy."Kód" = kprvni."Kód"
LEFT JOIN hodnoceni arb ON arb.id_noshodnoceni = pd.id_noshodnoceni AND arb."Poøadí" = pd."Poøadí arbitr" AND arb.id_krokvechodn = 488854
LEFT JOIN hodnota_kriteria karb ON karb.id_hodnoceni = arb.id  AND karb."Kód" = kprvni."Kód" )

SELECT p."Registraèní èíslo projektu" "Èíslo projektu",
       s."Název subjektu",
       w.kod "Kód stavu",
       body.pocetbodu,
       k."První celkem bodù" "H1 bodù",
       k."Druhý celkem bodù" "H2 bodù",
       k."Arbitr bodù" ,
       bprvni."Kódy nesplnìných binárù" "Nesplnìné bináry H1" ,
       bdruhy."Kódy nesplnìných binárù" "Nesplnìné bináry H2" ,
       barbitr."Kódy nesplnìných binárù" "Nesplnìné bináry arbitra" ,
       -- GROUP_CONCAT(DISTINCT k."Bináry proti sobì") "Hodnocení binárù",
       GROUP_CONCAT(DISTINCT
        FLOOR(CASE
        WHEN "Li¹í se o %" >= 50 THEN "Li¹í se o %"
	END)
	) AS "Li¹í se o procentních bodù",
       GROUP_CONCAT(DISTINCT  -- VYHODIT DISTINCT
        CASE
        WHEN "Li¹í se o %" >= 50 THEN k."Kód"
	END ) AS "V kritériích"
              
FROM projekt p
INNER JOIN v_rav_umscisstavwf w ON w.id = p.id_wfstav
INNER JOIN vyzva v ON v.id = p.id_vyzva
INNER JOIN subjekt s ON s.id_prjgg = p.id AND s.id_typsubjektuedit = 413462
INNER JOIN kriteria k ON k.id_noshodnoceni = p.id
LEFT JOIN vylucovaci bprvni ON bprvni.id_hodnoceni = k.id_prvnihodn
LEFT JOIN vylucovaci bdruhy ON bdruhy.id_hodnoceni = k.id_druhehodn
LEFT JOIN vylucovaci barbitr ON barbitr.id_hodnoceni = k.id_arbhodn
INNER JOIN v_rav_umvhodnstatusdh body ON body.id_noshodnoceni = p.id AND body.id_krokvechodn = 488854

WHERE v."Èíslo výzvy" = '01_22_002'
AND w.kod IN ('PP22','PN23','PP23a','PP23b','PP25a','PP25b','PU25','PN25','PU26','PP26','PN26','PP30')
-- AND p."Registraèní èíslo projektu" IN ('CZ.01.01.01/01/22_002/0000555','CZ.01.01.01/01/22_002/0000120','CZ.01.01.01/01/22_002/0000354')
-- AND ( k."První celkem bodù" = 0 OR k."Druhý celkem bodù" = 0 )

GROUP BY  "Èíslo projektu",
       s."Název subjektu",
       w.kod ,
       k."První celkem bodù",
       k."Druhý celkem bodù" ,
       k."Arbitr bodù" ,
       bprvni."Kódy nesplnìných binárù" ,
       bdruhy."Kódy nesplnìných binárù" ,
       barbitr."Kódy nesplnìných binárù",
       body.pocetbodu






