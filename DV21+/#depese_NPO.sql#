select	 "V_BI_UMZPROJEKT"."Registrační číslo projektu" as "Registrační číslo projektu",
	 "V_BI_UMSZPRAVAPRJ"."DATUMODESLANI" as "DATUMODESLANI",
	 "V_BI_UMSZPRAVAPRJ"."LAST_MODIF_UZIVATEL" as "LAST_MODIF_UZIVATEL",
	 "V_BI_UMSZPRAVAPRJ"."OD" as "OD",
	 "V_BI_UMSZPRAVAPRJ"."ZARAZENIODESILATELE" as "ZARAZENIODESILATELE",
	 "V_BI_UMSZPRAVAPRJ"."CREATE_UZIVATEL" as "CREATE_UZIVATEL",
	 "V_BI_UMSZPRAVAPRJ"."Naposledy změněno" as "Naposledy změněno" 
 from	"ISUM"."V_BI_UMZPROJEKT" "V_BI_UMZPROJEKT",
	"ISUM"."V_BI_UMSZPRAVAPRJ" "V_BI_UMSZPRAVAPRJ" 
 where   "V_BI_UMSZPRAVAPRJ"."ID_NOSITELZPRAVY"="V_BI_UMZPROJEKT"."ID"
  -- and 	 "V_BI_UMSZPRAVAPRJ"."ZARAZENIODESILATELE" ='API.OP PIK'
-- and "V_BI_UMZPROJEKT"."Registrační číslo projektu" like '%CZ.31%'
AND "V_BI_UMZPROJEKT".KodPrioritniOsa  in ('31.1', '31.2', '31.3', '31.5','31.26') 
order by "V_BI_UMZPROJEKT"."Registrační číslo projektu", "V_BI_UMSZPRAVAPRJ"."DATUMODESLANI" DESC


