SELECT p."Registraèní èíslo projektu",
       pwf."Kód" "Kód stavu" ,
       count(hs.id)


FROM projekt p 
INNER JOIN historie_stavu hs ON hs.nositelid = p.id
INNER JOIN ciselnik_stav_workflow pwf ON pwf.id = hs.id_stavdo

WHERE pwf."Kód" = 'PU22'
AND p."Registraèní èíslo projektu" IN ('CZ.01.02.01/07/23_021/0002918','CZ.01.02.01/07/23_021/0002635','CZ.01.02.01/07/23_021/0001805','CZ.01.02.01/07/23_021/0002897','CZ.01.02.01/07/23_021/0001496','CZ.01.02.01/07/23_021/0002723','CZ.01.02.01/07/23_021/0002717','CZ.01.02.01/07/23_021/0002472','CZ.01.02.01/07/23_021/0002130','CZ.01.02.01/07/23_021/0002705','CZ.01.02.01/07/23_021/0002117','CZ.01.02.01/07/23_021/0002243','CZ.01.02.01/07/23_021/0002475','CZ.01.02.01/07/23_021/0001946','CZ.01.02.01/07/23_021/0002020')


GROUP BY p."Registraèní èíslo projektu", pwf."Kód" 
