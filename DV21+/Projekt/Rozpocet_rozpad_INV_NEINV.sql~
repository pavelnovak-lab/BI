-- DESCRIPTION = 'INV/NEINV' AS

SELECT v."Číslo výzvy",
       v."Název výzvy",
       prg."Kód" "Kód Priority",
       prg."Název" "Priorita",
       sc.kodnovy as  "Kód SC",
       sc.nazev as  "SC",
       op.kodnovy as  "Kód Opatření",
       op.nazev as "Opatření",
       p."Registrační číslo projektu" AS "Registrační číslo projektu",
       w."Kód" "Kód stavu" ,
       pzf."Celkové zdroje připadající na způsobilé výdaje" AS "CZV Projektu",
       pf."Příspěvek Unie" "EU" ,
       SUM(CASE 
        	WHEN rp."Název" = 'Celkové způsobilé výdaje - neinvestiční' 
            	OR rp."Název" = 'Způsobilé výdaje - neinvestiční'
        	THEN rp."Částka celkem"
        	ELSE 0
    	END) AS "Celkové Investice",
    SUM(CASE 
             WHEN rp."Název" = 'Celkové způsobilé výdaje - investiční' 
             OR rp."Název" = 'Způsobilé výdaje - investiční'
             THEN rp."Částka celkem"
             ELSE 0
    	END) AS "Celkové Neinvestice"

FROM projekt AS p
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id  
INNER JOIN vyzva AS v ON p.id_vyzva = v.id
INNER JOIN prehled_zdroju_financovani pf ON pf.id_projekt = p.id AND pf.id_faze = 99991000000000005 -- aktuální stav 
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN specificky_cil op on op.id=vh.id_speccil
INNER JOIN specificky_cil sc on sc.id=op.id_hierarchie
INNER JOIN programova_linie prg ON prg.id = sc.id_osa


INNER JOIN rozpocet_hlavicka AS rh ON p.id = rh.id_nrozpocet
INNER JOIN rozpocet_polozka AS rp ON rp.id_hlavicka = rh.id

WHERE p."Registrační číslo projektu" IS NOT NULL 

GROUP BY 
    sc."Číslo SC/opatření ŘO formát",
    p."Registrační číslo projektu",
    csw."Kód",
    csw."Název",
    v."Číslo výzvy",
    v."Název výzvy",
    pzf."Celkové zdroje připadající na způsobilé výdaje"

ORDER BY "Registrační číslo projektu" ASC;
