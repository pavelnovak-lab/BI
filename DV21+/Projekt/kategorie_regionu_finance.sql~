CREATE or REPLACE view "rozpad_financovani_prodle_KR" FOLDER= AS 

SELECT op.nazev as "Opatøení" ,
       v."Název výzvy",
       p."Registraèní èíslo projektu" ,
       w."Kód" "Kód stavu",
       pzf."Pøíspìvek Unie" "EU" ,
       pzf."Celkové zdroje pøipadající na zpùsobilé výdaje" "CZV",
       ckr."Název" "KR"


FROM projekt p 
INNER JOIN vyzva v ON v.id = p.id_vyzva 
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN v_rav_umshisc op on op.id=vh.id_speccil
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id 
INNER JOIN prehled_zdroju_financovani_sckr pzf ON pzf.id_projekt = p.id AND pzf.id_faze = 99991000000010005
INNER JOIN ciselnik_kategorie_regionu ckr ON ckr.id = id_kategorieregionu

WHERE p."Registraèní èíslo projektu" is not null
-- AND p."Registraèní èíslo projektu" = 'CZ.01.01.01/01/22_002/0000106'

ORDER BY p."Registraèní èíslo projektu" 

