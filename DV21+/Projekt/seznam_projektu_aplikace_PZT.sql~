SELECT	op."Název specifického cíle/opatření" as "Opatření" ,
	v."Číslo výzvy" ,
	v."Název výzvy" ,
	wv."Kód" "Stav výzvy",
	p."Registrační číslo projektu" ,
 	w."Kód" "Stav projektu" ,
	p.id "ID projektu" 


FROM projekt p
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id
INNER JOIN vyzva v ON v.id = p.id_vyzva
INNER JOIN ciselnik_stav_workflow wv ON v.id_wfstav = w.id  
INNER JOIN vyzva_hierarchie vh ON vh.id_vyzva = v.id
INNER JOIN specificky_cil op on op.id=vh.id_speccil

WHERE p."Registrační číslo projektu" IS NOT NULL 
AND (op."Název specifického cíle/opatření" = 'Aplikace' OR v."Číslo výzvy" IN ('01_23_013', '01_24_046'))

ORDER BY v."Číslo výzvy" 

