SELECT	op.nazev as "Opatøení" ,
	v."Èíslo výzvy",
	v."Název výzvy" ,
	p."Registraèní èíslo projektu" ,
	w."Kód" "Kód stavu" ,
       -- vpo."Èástka poskytnuté veøejné podpory celkem v Kè" "CZV pro VPo",
