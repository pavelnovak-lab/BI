
CREATE or REPLACE view "rozpracovane_iskp_rozpocet_vpo" FOLDER= AS
SELECT v."Èíslo výzvy",
       -- p."Registraèní èíslo projektu" ,
       p."Identifikace ¾ádosti (hash)",
       w."Kód" ,
       p."Datum zmìny stavu",
       GROUP_CONCAT(DISTINCT '; ',  s."Název subjektu") "Subjekt" ,
       GROUP_CONCAT(DISTINCT '; ',  ts."Název") "Typy subjektù" ,
       sr."Název skupiny rozpoètu",
       -- psc."Pøechodové" ,
       psc."Ménì rozvinutý region" ,
       -- vpo.id_verejnapodpora,
       kvpo."Kód" "Kód VPo",
       kvpo."Název" "Polo¾ka VPo"


FROM projekt p
INNER JOIN vyzva v ON v.id = p.id_vyzva
LEFT JOIN subjekt s ON s.id_prjgg = p.id AND s."Neplatný od" is null -- AND s.id_typsubjektuedit IN (413462, 413467) -- ¾adatel, partner s FP
INNER JOIN ciselnik_stav_workflow w ON p.id_wfstav = w.id
INNER JOIN ciselnik_typ_subjektu ts ON ts.id = s.id_typsubjektuedit 
LEFT JOIN rozpocet_hlavicka hr ON hr.id_nrozpocet = p.id
LEFT JOIN rozpocet_skupina sr ON hr.id_skupina = sr.id
INNER JOIN projekt_specificky_cil psc ON psc.id_prjgg = p.id
LEFT JOIN verejna_podpora vpo ON vpo.id_projekt = p.id
LEFT JOIN ciselnik_kombinace_verejne_podpory kvpo ON kvpo.id = vpo.id_verejnapodpora
