WITH arbitr as (
SELECT avg(hk."Počet bodů") "Body B1",
	 h.id_noshodnoceni
  FROM projekt p
  INNER JOIN hodnoceni h ON h.id_noshodnoceni = p.id
  INNER JOIN hodnota_kriteria hk ON hk.id_hodnoceni = h.id 
  WHERE h."Platný" = 'A'
  AND h."Finalizováno" = 'A'
  AND h."Schváleno schvalovatelem" = 'A'
  AND h.id_krokvechodn = 488854 -- 2. krok VH
--AND (v."Číslo výzvy" = '01_22_002'
  sql AND ( (hk."Kód" = 'B1.' AND p.id_vyzva in (18990672, 18995356) ) OR -- vyzva 01_22_001, 01_22_002 Aplikace I, PoC
  sql 	(hk."Kód" = 'B 7.' AND p.id_vyzva = 19009827 ) ) -- vyzva 01_22_003 Inovace I


