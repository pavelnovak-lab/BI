v."Číslo výzvy",
v."Datum změny" 
FROM
vyzva v
WHERE
v."Číslo výzvy" like '01_%'
--and v.id in (31025415,132416676)
and v."Datum změny" > to_date('yyyy-MM-dd HH:mm:ss','2023-08-02 08:00:00')
