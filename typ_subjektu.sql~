SELECT p."Registraèní èíslo projektu"
       cis."Název"

FROM isum.v_bi_UmzPrjGGvs vs
INNER JOIN isum.v_bi_UmsCisZakladni cis ON cis.id = vs.id_typsubjektu
INNER JOIN isum.v_bi_umzprjggii p ON p.id = vs.id_prjgg 



WHERE p."Registraèní èíslo projektu" is not null
AND   cis."Název" = '%podíl%'




