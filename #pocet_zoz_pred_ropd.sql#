SELECT p."Registrační číslo projektu" ,
       zoz."Pořadové číslo ŽoZ",
       zoz."Datum účinnosti",
	 zoz."Datum podání" "Datum podání ŽoZ",
	 p.kodwfstav ,
	 hs.datumod "Přepnuto do PP30" ,
	 SUBSTR(p.kompetencniutvar, 6 ) AS "Program podpory" 
FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmzZoZProjekt zoz ON zoz.id_zad = p.id
-- INNER JOIN isum.v_bi_UmsCisZakladni ci ON ci.id = zoz.id_zavaznostzmeny
INNER JOIN isum.v_bi_UmsWFHistorieStavu hs ON hs.NositelId = p.id


WHERE
zoz.id_wfstav = 656429 -- schvalena ŽoZ
-- AND p."Registrační číslo projektu" = 'CZ.01.3.12/0.0/0.0/17_136/0011438'
-- AND ci."Název" is null
-- AND p."Registrační číslo projektu" is not null
AND hs.stavdo = 'PP30'
-- AND p.kodwfstav = 'PP36'
AND trunc(zoz."Datum podání") < trunc(hs.datumod)
AND SUBSTR(p.kompetencniutvar, 6 ) = 'Technologie'
AND p.kodwfstav in ('PP29','PP27a','PP27b','PP30','PP36','PP37','PP40','PP41','PP42','PP43')

