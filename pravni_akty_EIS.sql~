SELECT p."Registrační číslo projektu",
       pzf."Příspěvek Unie" "EU v poslední PA",
       pzf."Celkové způsobilé výdaje" "CZV v posledním PA",
       p.kodwfstav ,
       p."IČ" ,
       p.zadatel ,
       zop.schv "Proplaceno",
       zop.pocet "Počet ŽoP",
       zop.posledni_datum "Datum proplacení závěrečné ŽoP"
       


FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UMFPFCelkem pzf ON pzf.id_projekt = p.id AND pzf.id_faze = 99991000000000005 -- aktuální stav 
-- INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby 
INNER JOIN (SELECT platba.id_nositelplatby,
      	   	   sum(rf.CASTKASCHVALENA) schv,
		   max(platba.DATPROPLACENAPRIJ) posledni_datum,
		   max(platba."PORADI#Pořadí finančního plánu") pocet

	     FROM isum.v_bi_UmpPlatbaPrj platba 
	     INNER JOIN isum.v_bi_UmpRozpisFin rf ON rf.id_platba = platba.id AND rf.id_ukazatel in ( 361356 ) -- XX, YY, 10a, ZZ
	     GROUP BY platba.id_nositelplatby
 	    ) zop  ON p.id=zop.id_NositelPlatby

