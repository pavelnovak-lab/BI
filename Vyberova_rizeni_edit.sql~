 where d.id_vyberovarizeni=vz.id and d.ID_VERZESUBJEKTU>0 and rownum=1) as vdod

FROM isum.v_bi_umzprojekt p
inner join isum.v_bi_umvvyberovarizeni vz on vz.id_nositelvr=p.id

WHERE p."Registraèní èíslo projektu"='CZ.01.1.02/0.0/0.0/15_002/0000006'



















