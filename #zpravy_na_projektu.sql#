select
p."Registrační číslo projektu",
z.DatumOdeslani,
REPLACE(REPLACE(z."Text",CHR(10),' $ '),CHR(13),' $ ') as Text,
a.Adresa,
z.AdresatiText,
z."Vázáno na objekt"

from isum.v_bi_umszpravyprojektu z 
inner join isum.v_bi_UMSAdresaAbs a on a.id=z.ID_ADRODESILATEL
inner join isum.v_bi_UmzProjekt p on p.id = z.id_nositelzpravy

where z.DatumOdeslani is not null
AND p."Registrační číslo projektu" = 'CZ.01.01.01/02/22_003/0000252'

ORDER BY z.DatumOdeslani