        sdp.typdp

FROM isum.v_bi_UmzVyzva v 
inner join isum.v_bi_umzvyzvahierarchie vh on vh.id_vyzva = v.id
inner join isum.v_bi_umshisc sh on sh.id = vh.id_speccil
