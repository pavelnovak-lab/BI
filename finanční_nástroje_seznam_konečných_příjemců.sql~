SELECT fn."Registrační číslo fondu fondů",
       fn."Název fondu fondů",
       kp."Jméno nebo Název",
       typ."Název" AS "Typ konečného příjemce",
       kp."Identifikační údaj smlouvy",
       kp."Datum podpisu smlouvy",
       zor.id,
       MAX(CASE WHEN nazev."Kód" = 'PKP0401' THEN rzfin."Datum" END) AS "Datum předp splacení úvěru",
       MAX(CASE WHEN nazev."Název" = 'Datum selhání úvěru' THEN rzfin."Datum" END) AS "Datum selhání úvěru",
       MAX(CASE WHEN nazev."Název" = 'Datum splacení úvěru' THEN rzfin."Datum" END) AS "Datum splacení úvěru",
       MAX(CASE WHEN nazev."Název" = 'Sjednaná výše úvěru' THEN rzfin."Celkové způsobilé výdaje" END) AS "Sjednaná výše úvěru",
       MAX(CASE WHEN nazev."Název" = 'Výše splacené jistiny úvěru kumulativní' THEN rzfin."Celková částka pro odměny" END) AS "Výše spl. jist. kumulativní",
       MAX(CASE WHEN nazev."Název" = 'Výše uhrazených úroků z prodlení, sankcí a vymožených nákladů soudních řízen' THEN rzfin."Celková částka pro odměny" END) AS "Úroky z prodlení",
       MAX(CASE WHEN nazev."Název" = 'Výše uhrazených úroků z úvěru kumulativní' THEN rzfin."Celková částka pro odměny" END) AS "Uhrazené úroky",
       MAX(CASE WHEN nazev."Název" = 'Výše vymožených sankcí a nákladů soudních řízení vztahujících se k příspěvku na úhradu úroků / k ceně záruky' THEN rzfin."Celkové způsobilé výdaje" END) AS "Vymožené sankce",
       MAX(CASE WHEN nazev."Název" = 'Výše vyplaceného příspěvku na technickou podporu' THEN rzfin."Celkové způsobilé výdaje" END) AS "Vyplaceno na TP",
       MAX(CASE WHEN nazev."Název" = 'Výše vyplaceného příspěvku na úhradu úroků / k ceně záruky' THEN rzfin."Celkové způsobilé výdaje" END) AS "Na úhradu úroků k záruce",
       MAX(CASE WHEN nazev."Název" = 'Výše čerpání úvěru' THEN rzfin."Celkové způsobilé výdaje" END) AS "Výše čerpání úvěru"

FROM isum.v_bi_UMPFinNastroj fn
INNER JOIN isum.v_bi_UMPFNPrehledKP kp ON kp.id_finnastroj = fn.id
INNER JOIN isum.v_bi_UmsCisZakladni typ ON typ.id = kp.id_typprijemce
INNER JOIN isum.v_bi_UMPFNZOR zor ON zor.id = kp.id_fnzor
INNER JOIN isum.V_BI_UmpFNRozpisFin rzfin ON rzfin.ID_PREHLEDKP = kp.id
INNER JOIN isum.v_BI_UmsCISZakladni nazev ON nazev.id = rzfin.id_typ

WHERE fn."Registrační číslo fondu fondů" = 'FN_2017_001'
-- AND zor.id = 235584845
AND kp."Identifikační údaj smlouvy" = '2017-1460-E2'

GROUP BY fn."Registrační číslo fondu fondů",
         fn."Název fondu fondů",
         kp."Jméno nebo Název",
         typ."Název",
         kp."Identifikační údaj smlouvy",
         kp."Datum podpisu smlouvy" ,
	 zor.id



