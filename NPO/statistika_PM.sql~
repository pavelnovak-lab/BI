SELECT p."Registrační číslo projektu",
       p.create_cas ,
       (select prj.kodwfstav from prj WHERE rownum = 1) "stav"
       
FROM isum.v_bi_UmzProjekt prj

WHERE p.KodPrioritniOsa in ('31.3') 
AND p."Registrační číslo projektu" is not null 
AND rownum = 1
ORDER BY p.create_cas
