SELECT	p."Registrační číslo projektu" ,
	-- platba."Číslo žádosti o platbu" ,
	platba.*
FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmzVyzva v ON v.id=p.id_vyzva 
INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby 
INNER JOIN
( SELECT hs.NositelId,
  	 trunc(sysdate) - trunc(datumod) "Dní v P4 (nevrácena)" ,
  	 count(hs.id)
  FROM isum.v_bi_UmsWFHistorieStavu hs
  WHERE stavdo = 'P4'
  HAVING count(hs.id)=1
  GROUP BY hs.NOSITELID,
  	"Dní v P4 (nevrácena)") hs ON  hs.NositelId = platba.id
  
WHERE v."Číslo výzvy" = '31_22_001'
AND platba.kodwfstav = 'P4'

ORDER BY platba."Číslo žádosti o platbu"


