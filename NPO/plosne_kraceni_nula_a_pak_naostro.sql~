SELECT platba."»Ìslo æ·dosti o platbu" ,
       platba.kodwfstav ,
       k.ID_TYPKOREKCE,
       k.TYPKRACENI,
       k.VYSE

FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby
INNER JOIN isum.v_bi_UmpKorekce k ON k.id_platba = platba.id
-- INNER JOIN isum.V_BI_UMSCisTypKorekce tk ON tk.id = k.id_typkorekce


-- INNER JOIN isum.v_bi_UmfSoupiskaDokladPRJ s ON s.id_platba = platba.id


WHERE p.KodPrioritniOsa in ('31.3') 
AND k.SOUCTOVYRADEK  <> 'A'
AND platba."»Ìslo æ·dosti o platbu" = 'CZ.31.3.0/0.0/0.0/22_001/0005660/2024/001/POST'
