SELECT v."Èíslo výzvy", 
	p."Registraèní èíslo projektu" ,
       p.zed,
       p.akcezed,
       p.EXPORTZED,
       ci."Název",
       ci."Kód" ,
       p.kodwfstav,
       p.wfstavdatum "Daum zmìny stavu projektu", 
       platba."PORADI#Poøadí finanèního plánu" ,
       platba.kodwfstav  "Stav ®oP" ,
       platba."Datum zmìny stavu" "Datum zmìny stavu ®oP" ,
       rf.CASTKASCHVALENA "Èástka schválená" ,
       platba."Datum proplacení pøíjemci" ,
       LISTAGG( substr(dp.REGCISLO, -7, 7), ', ') "Detail platby",
       LISTAGG( DISTINCT zdroj."Kód", '; ') "Zdroj SR Kód",
       LISTAGG( DISTINCT zdroj."Název", '; ') "Zdroj SR"
       -- SUBSTR(p.kompetencniutvar, 6) "Komponenta NPO",
       -- hs.datumod,
       -- p."Bude se poøizovat EDSSMVS" EDS
       
FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmzVyzva v ON v.id=p.id_vyzva 
INNER JOIN isum.v_bi_UmsCisZakladni ci ON ci.id =  p.ID_AGRAKCEZED
INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby 
LEFT JOIN isum.v_bi_UmpRozpisFin rf ON rf.id_platba = platba.id AND rf.id_ukazatel in (361356) -- XX, YY, 10a
LEFT JOIN isum.v_bi_umpklasifikace dp ON dp.id_platba = platba.id AND dp.druhdp = 1
INNER JOIN isum.v_bi_UmsCisZakladni zdroj ON zdroj.id = dp.id_zdroj




WHERE platba.SOUCTOVYRADEK is null 
AND v."Èíslo výzvy" IN ('31_22_001','31_22_005')
AND p."Registraèní èíslo projektu" is not null 
-- AND platba."Èíslo ¾ádosti o platbu" = 'CZ.31.3.0/0.0/0.0/22_001/0004198/2023/001/POST'


GROUP BY v."Èíslo výzvy", 
	p."Registraèní èíslo projektu" ,
       p.zed,
       p.akcezed,
       p.EXPORTZED,
       ci."Název",
       ci."Kód" ,
       p.kodwfstav,
       p.wfstavdatum , 
       platba."PORADI#Poøadí finanèního plánu" ,
       platba.kodwfstav   ,
       platba."Datum zmìny stavu"  ,
       rf.CASTKASCHVALENA  ,
       platba."Datum proplacení pøíjemci" 



ORDER BY substr(p."Registraèní èíslo projektu",-5,5) ASC 



