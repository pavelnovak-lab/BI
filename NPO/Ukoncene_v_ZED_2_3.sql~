SELECT	(p.kompetencniutvar) AS "Komponenta NPO",
	p."Registrační číslo projektu" ,
       p.zadatel , 
       p."IČ",
       p.akcezed,
       p.kodwfstav ,
       platba."Datum změny stavu" "Datum prolacení",
       (rf.CASTKASCHVALENA) "Proplacená dotace" ,

       platba."Číslo žádosti o platbu" 

FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmsCisZakladni ci ON ci.id =  p.ID_AGRAKCEZED
INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby AND platba."Číslo žádosti o platbu" is not null
INNER JOIN isum.v_bi_UmpRozpisFin rf ON rf.id_platba = platba.id AND rf.id_ukazatel in ( 361356 ) -- XX, YY, 10a, ZZ

