SELECT	--v."Název výzvy",
	-- (p."Registraèní èíslo projektu"),
	-- p.kodwfstav "Stav projektu",
      	-- platba."PORADI#Poøadí finanèního plánu" ,
	-- platba.kodwfstav ,
	sum(CASE WHEN platba."Datum proplacení pøíjemci" is not null THEN 1
		 ELSE 0 END ) "Poèet proplacených ®oP",
	sum(CASE WHEN platba."Datum proplacení pøíjemci" is not null THEN rf.CASTKASCHVALENA
	     END) "Proplaceno (EU podíl)",
 	to_char(platba."Datum proplacení pøíjemci", 'YYYY-MM') "Proplaceno (mìsíc)",     	     

	sum(CASE WHEN platba."Datum proplacení pøíjemci" is null THEN 1
		 ELSE 0 END ) "Poèet neproplacených ®oP",
	sum(CASE WHEN platba."Datum proplacení pøíjemci" is null THEN pzf.PROC_EU *platba."VYUCTPLAN#Vyúètování plán"/100
	     END) "Celkem plánováno pøedlo¾it (EU podíl)",
 	CASE WHEN platba."Datum proplacení pøíjemci" is null THEN to_char(platba."Datum pøedlo¾ení", 'YYYY-MM')
	     END "Plánované pøedlo¾ení (mìsíc)"
 	
FROM isum.v_bi_UmzProjekt p
-- INNER JOIN isum.v_bi_umzprjgg gg ON gg.id=p.id 
INNER JOIN isum.v_bi_UmzVyzva v ON v.id=p.id_vyzva
INNER JOIN isum.v_bi_UmpPlatbaPrj platba ON p.id=platba.id_NositelPlatby
INNER JOIN isum.v_bi_UMFPFCelkem pzf ON pzf.id_projekt = p.id AND pzf.id_faze = 99991000000000005 -- aktuální stav 
INNER JOIN isum.v_bi_UmpRozpisFin rf ON rf.id_platba = platba.id AND rf.id_ukazatel in ( 361356 ) -- XX, YY, 10a, ZZ

WHERE v."Èíslo výzvy" IN ('31_22_014','31_22_015')
AND p."Registraèní èíslo projektu" is not null 
AND platba.SOUCTOVYRADEK is null 
AND p.kodwfstav  not like 'PN%'
AND platba.kodwfstav not IN ('N1','N2')

GROUP BY to_char(platba."Datum proplacení pøíjemci", 'YYYY-MM'),
      	 CASE WHEN platba."Datum proplacení pøíjemci" is null THEN to_char(platba."Datum pøedlo¾ení", 'YYYY-MM') END

ORDER BY CASE WHEN platba."Datum proplacení pøíjemci" is null THEN to_char(platba."Datum pøedlo¾ení", 'YYYY-MM') END asc 


