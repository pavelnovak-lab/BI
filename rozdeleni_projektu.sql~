SELECT devatenact.prj_19,
       count(devatenact."IÈO")

FROM 
( SELECT count(p.id) as prj_19 ,
	p."IÈ" as "IÈO"	
 FROM isum.v_bi_UmzProjekt p 
 WHERE trunc(p."Datum registrace ¾ádosti")  <= to_date('2019-12-31','yyyy-mm-dd')
 AND p."Registraèní èíslo projektu" is not null
-- AND p."IÈ" = '45274649'
 GROUP BY p."IÈ") devatenact
 
GROUP BY devatenact.prj_19

ORDER BY devatenact.prj_19



