SELECT count(hist19.id) as prj_19,
       hist19."IÈ"

FROM isum.v_bi_UmzProjekt p
  (SELECT *
   FROM 
    (SELECT p."Registraèní èíslo projektu" ,
	    p.id,
	    hs.datumod "Poslední datum 2019",
	    hs.stavdo,
	    p."IÈ"
    FROM isum.v_bi_UmzProjekt p
    INNER JOIN isum.v_bi_UmsWFHistorieStavu hs ON hs.NositelId = p.id

    WHERE p."Registraèní èíslo projektu" is not null 
    AND trunc(hs.datumod) <= to_date('2019-12-31','yyyy-mm-dd')
    
    ORDER BY hs.stavdo DESC ) h19 ON h19.id = p.id

  WHERE rownum = 1) hist19 ON hist19.id = p.id 

GROUP BY hist19."IÈ"




AND (stavdo like ('PP%') or stavdo = 'V2' or stavdo = 'V5' or stavdo like 'PU%')

GROUP BY "IÈ"



