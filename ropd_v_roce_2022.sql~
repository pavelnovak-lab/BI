SELECT
       	p."Registraèní èíslo projektu" ,
       SUBSTR(p.kompetencniutvar, 6) AS "Program podpory" ,
       p.kodwfstav "Stav projektu" ,
       hs.datumod "Datum pøepnutí PP30",
       v."Èíslo výzvy",
       v."Název výzvy",
       pril.NAZEVPRIL,
       sml.NA
       

       
FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmzVyzva v ON v.id=p.id_vyzva 
INNER JOIN isum.v_bi_UmsWFHistorieStavu hs ON hs.NositelId = p.id
INNER JOIN isum.v_bi_UMFSmlouva sml ON sml.id_nositelsml = p.id
INNER JOIN isum.v_bi_UMSPrilohyPA pril ON pril.id_nositelpril = sml.id

WHERE stavdo = 'PP30'
AND p.kodwfstav in ('PP30','PP36','PP37','PP40','PP41','PP42','PP43')
AND trunc(hs.datumod) > to_date('2021-12-31','yyyy-mm-dd')
AND p."Registraèní èíslo projektu" = 'CZ.01.1.02/0.0/0.0/21_375/0026671'
AND v.JEEDS <> 'A'

