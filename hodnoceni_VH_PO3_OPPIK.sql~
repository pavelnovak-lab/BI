WITH Hodnoceni AS (
    SELECT 
        h.id_noshodnoceni,
        h.id_souborkrit,
        hodnotitel."Kód" as kod_hodnotitele,
        h.pocetbodu as body_v_posudku,
        h.opravnehodnoceni,
        CASE WHEN h.opravnehodnoceni = 'A' THEN 1 ELSE 0 END as is_opravne,
        kr.id_kriterium,
        kr.kod,
        kr.vyhovel,
        kr.pocetbodu,
        kr.maxbodu
    FROM isum.v_bi_UmvHodnoceniPrj h
    INNER JOIN isum.v_bi_UMVHodnotaKrit kr ON kr.id_hodnoceni = h.id
    INNER JOIN isum.v_bi_UmvHodnotitel hodnotitel ON hodnotitel.id = h.id_hodnotitel 
    WHERE h.platnost = 'A'
      AND h.arbiter = 'N'
      AND h.finalizovano = 'A'
      AND kr.needitovatelne = 'N'
      AND kr.islist = 'A'
)
, OpravneHodnoceni AS (
    SELECT 
        id_noshodnoceni,
        id_souborkrit,
        kod_hodnotitele as kod_opravneho,
        body_v_posudku as body_opravneho
    FROM Hodnoceni
    WHERE opravnehodnoceni = 'A'
)

, Kategorie AS (
    SELECT
        id_noshodnoceni,
        id_souborkrit,

        -- Opravné hodnocení A–E
        CASE WHEN SUM(CASE WHEN is_opravne=1 AND UPPER(kod) LIKE 'A%' THEN 1 END) > 0 THEN 'Ano' ELSE 'Ne' END as "Opravné hodnocení v A",
        CASE WHEN SUM(CASE WHEN is_opravne=1 AND UPPER(kod) LIKE 'B%' THEN 1 END) > 0 THEN 'Ano' ELSE 'Ne' END as "Opravné hodnocení v B",
        CASE WHEN SUM(CASE WHEN is_opravne=1 AND UPPER(kod) LIKE 'C%' THEN 1 END) > 0 THEN 'Ano' ELSE 'Ne' END as "Opravné hodnocení v C",
        CASE WHEN SUM(CASE WHEN is_opravne=1 AND UPPER(kod) LIKE 'D%' THEN 1 END) > 0 THEN 'Ano' ELSE 'Ne' END as "Opravné hodnocení v D",
        CASE WHEN SUM(CASE WHEN is_opravne=1 AND UPPER(kod) LIKE 'E%' THEN 1 END) > 0 THEN 'Ano' ELSE 'Ne' END as "Opravné hodnocení v E",

        -- Splněné bináry v A
        CASE WHEN SUM(CASE WHEN UPPER(kod) LIKE 'A%' AND vyhovel = 'A' THEN 1 ELSE 0 END) =
                  SUM(CASE WHEN UPPER(kod) LIKE 'A%' THEN 1 ELSE 0 END)
             THEN 'Ano' ELSE 'Ne' END as "Splněné bináry v A",

        -- Body a max body pro B–E
        SUM(CASE WHEN UPPER(kod) LIKE 'B%' THEN pocetbodu/2 END) as "Počet bodů v B",
        SUM(CASE WHEN UPPER(kod) LIKE 'B%' THEN maxbodu/2 END) as "Max bodů v B",
        SUM(CASE WHEN UPPER(kod) LIKE 'C%' THEN pocetbodu/2 END) as "Počet bodů v C",
        SUM(CASE WHEN UPPER(kod) LIKE 'C%' THEN maxbodu/2 END) as "Max bodů v C",
        SUM(CASE WHEN UPPER(kod) LIKE 'D%' THEN pocetbodu/2 END) as "Počet bodů v D",
        SUM(CASE WHEN UPPER(kod) LIKE 'D%' THEN maxbodu/2 END) as "Max bodů v D",
        SUM(CASE WHEN UPPER(kod) LIKE 'E%' THEN pocetbodu/2 END) as "Počet bodů v E",
        SUM(CASE WHEN UPPER(kod) LIKE 'E%' THEN maxbodu/2 END) as "Max bodů v E"

    FROM Hodnoceni
    GROUP BY id_noshodnoceni, id_souborkrit
)
, RadniHodnoceni AS (
    SELECT 
        id_noshodnoceni,
        id_souborkrit,
        kod_hodnotitele,
        body_v_posudku,
        ROW_NUMBER() OVER (PARTITION BY id_noshodnoceni, id_souborkrit ORDER BY kod_hodnotitele) AS rn
    FROM Hodnoceni
    WHERE opravnehodnoceni = 'N'
)
, Rozdil AS (
    SELECT 
        r1.id_noshodnoceni,
        r1.id_souborkrit,
        r1.kod_hodnotitele as kod_hodnotitele_1,
        r1.body_v_posudku as body_1,
        r2.kod_hodnotitele as kod_hodnotitele_2,
        r2.body_v_posudku as body_2,
        ABS(r1.body_v_posudku - r2.body_v_posudku) as rozdil_bodu
    FROM RadniHodnoceni r1
    JOIN RadniHodnoceni r2 
      ON r1.id_noshodnoceni = r2.id_noshodnoceni 
     AND r1.id_souborkrit = r2.id_souborkrit
     AND r1.rn = 1 AND r2.rn = 2
)
SELECT  
    sc.nazev "SC",
    v."Číslo výzvy",
    v."Název výzvy",
    p."Registrační číslo projektu",
    p.zadatel,
    p.kodwfstav "Stav projektu" ,
    hs.p23 "Datum přepnutí stavu po VH",
    sh.pocetbodu "Celkem bodů ve VH",
    ci."Název" "Status hodnocení VH",
    kategorie."Splněné bináry v A",
    kategorie."Opravné hodnocení v A",
    kategorie."Počet bodů v B",
    kategorie."Max bodů v B",
    kategorie."Počet bodů v B" / kategorie."Max bodů v B" "Procent v B",
    kategorie."Opravné hodnocení v B",
    kategorie."Počet bodů v C",
    kategorie."Max bodů v C",
    kategorie."Počet bodů v C" / kategorie."Max bodů v C" "Procent v C",
    kategorie."Opravné hodnocení v C",
    kategorie."Počet bodů v D",
    kategorie."Max bodů v D",
    kategorie."Počet bodů v D" / kategorie."Max bodů v D" "Procent v D",
    kategorie."Opravné hodnocení v D",
    kategorie."Počet bodů v E",
    kategorie."Max bodů v E",
    kategorie."Počet bodů v E" / kategorie."Max bodů v E" "Procent v E",
    kategorie."Opravné hodnocení v E",
    r.kod_hodnotitele_1,
    r.body_1,
    r.kod_hodnotitele_2,
    r.body_2,
    r.rozdil_bodu
FROM isum.v_bi_UmzProjekt p
INNER JOIN isum.v_bi_UmzVyzva v ON v.id=p.id_vyzva 
INNER JOIN isum.v_bi_UMZVYZVAHIERARCHIE vh ON vh.id_vyzva = v.id 
INNER JOIN isum.v_bi_UMSHiSC sc ON sc.id = vh.id_speccil
INNER JOIN isum.v_bi_UMVHodnSoubKritVyz skv ON skv.id_vyzva = v.id
INNER JOIN isum.v_bi_UMVHodnStatusdh sh ON sh.id_souborkrit = skv.id_souborkrit AND sh.id_noshodnoceni = p.id 
INNER JOIN isum.v_bi_UmsCisZakladni ci ON ci.id =  sh.id_statushodn 
INNER JOIN (
    SELECT max(datumod) p23,
           nositelid
    FROM isum.v_bi_UmsWFHistorieStavu
    WHERE stavdo like '%23%' 
    GROUP BY nositelid
) hs ON hs.NositelId = p.id
INNER JOIN Kategorie kategorie ON kategorie.id_noshodnoceni = p.id 
                               AND kategorie.id_souborkrit = skv.id_souborkrit
INNER JOIN Rozdil r ON r.id_noshodnoceni = p.id 
                   AND r.id_souborkrit = skv.id_souborkrit
WHERE sc."Číslo specifického cíle / oper" IN ('01.3.09.3.1','01.3.10.3.2','01.3.12.3.3','01.3.14.3.4','01.3.15.3.5','01.3.43.3.6')
  AND skv.pocethodnotitelu = 2
  -- AND p."Registrační číslo projektu" IN ('CZ.01.3.10/0.0/0.0/15_010/0003477','CZ.01.3.10/0.0/0.0/15_010/0000001')
ORDER BY p."Registrační číslo projektu"


-------------------- Optimalizováno s Claude ----------------------------------------


--- Optimalizace mě nutí načítat co nejméně dat. Proto napřet filtruji v tomto CTE 

WITH VyfiltrovaneProjekty AS (
    -- Nejdřív vyfiltruju pouze relevantní projekty
    SELECT DISTINCT p.id, p."Registrační číslo projektu", p.zadatel, p.kodwfstav, p.id_vyzva
    FROM isum.v_bi_UmzProjekt p
    INNER JOIN isum.v_bi_UmzVyzva v ON v.id = p.id_vyzva 
    INNER JOIN isum.v_bi_UMZVYZVAHIERARCHIE vh ON vh.id_vyzva = v.id 
    INNER JOIN isum.v_bi_UMSHiSC sc ON sc.id = vh.id_speccil
    WHERE sc."Číslo specifického cíle / oper" IN ('01.3.09.3.1','01.3.10.3.2','01.3.12.3.3','01.3.14.3.4','01.3.15.3.5','01.3.43.3.6')
),
Hodnoceni AS (
    SELECT 
        h.id_noshodnoceni,
        h.id_souborkrit,
        h.id_hodnotitel,
        hodnotitel."Kód" as kod_hodnotitele,
        h.pocetbodu as body_v_posudku,
        h.opravnehodnoceni,
        kr.kod,
        kr.vyhovel,
        kr.pocetbodu,
        kr.maxbodu
    FROM VyfiltrovaneProjekty fp
    INNER JOIN isum.v_bi_UmvHodnoceniPrj h ON h.id_noshodnoceni = fp.id
    INNER JOIN isum.v_bi_UMVHodnotaKrit kr ON kr.id_hodnoceni = h.id
    INNER JOIN isum.v_bi_UmvHodnotitel hodnotitel ON hodnotitel.id = h.id_hodnotitel 
    WHERE h.platnost = 'A'
      AND h.arbiter = 'N'
      AND h.finalizovano = 'A'
      AND kr.needitovatelne = 'N'
      AND kr.islist = 'A'
),
Kategorie AS (
    SELECT
        id_noshodnoceni,
        id_souborkrit,
        
        -- Opravné hodnocení - použijeme MAX místo CASE WHEN SUM
        MAX(CASE WHEN opravnehodnoceni='A' AND UPPER(kod) LIKE 'A%' THEN 'Ano' END) as "Opravné hodnocení v A",
        MAX(CASE WHEN opravnehodnoceni='A' AND UPPER(kod) LIKE 'B%' THEN 'Ano' END) as "Opravné hodnocení v B",
        MAX(CASE WHEN opravnehodnoceni='A' AND UPPER(kod) LIKE 'C%' THEN 'Ano' END) as "Opravné hodnocení v C",
        MAX(CASE WHEN opravnehodnoceni='A' AND UPPER(kod) LIKE 'D%' THEN 'Ano' END) as "Opravné hodnocení v D",
        MAX(CASE WHEN opravnehodnoceni='A' AND UPPER(kod) LIKE 'E%' THEN 'Ano' END) as "Opravné hodnocení v E",

        -- Splněné bináry v A
        CASE 
            WHEN COUNT(CASE WHEN UPPER(kod) LIKE 'A%' THEN 1 END) = 0 THEN 'Ne'
            WHEN SUM(CASE WHEN UPPER(kod) LIKE 'A%' AND vyhovel = 'A' THEN 1 ELSE 0 END) =
                 COUNT(CASE WHEN UPPER(kod) LIKE 'A%' THEN 1 END)
            THEN 'Ano' 
            ELSE 'Ne' 
        END as "Splněné bináry v A",

        -- Body a horní hranice ve skupinách kritérií
        SUM(CASE WHEN UPPER(kod) LIKE 'B%' THEN pocetbodu ELSE 0 END) / 2.0 as "Počet bodů v B",
        SUM(CASE WHEN UPPER(kod) LIKE 'B%' THEN maxbodu ELSE 0 END) / 2.0 as "Max bodů v B",
        SUM(CASE WHEN UPPER(kod) LIKE 'C%' THEN pocetbodu ELSE 0 END) / 2.0 as "Počet bodů v C",
        SUM(CASE WHEN UPPER(kod) LIKE 'C%' THEN maxbodu ELSE 0 END) / 2.0 as "Max bodů v C",
        SUM(CASE WHEN UPPER(kod) LIKE 'D%' THEN pocetbodu ELSE 0 END) / 2.0 as "Počet bodů v D",
        SUM(CASE WHEN UPPER(kod) LIKE 'D%' THEN maxbodu ELSE 0 END) / 2.0 as "Max bodů v D",
        SUM(CASE WHEN UPPER(kod) LIKE 'E%' THEN pocetbodu ELSE 0 END) / 2.0 as "Počet bodů v E",
        SUM(CASE WHEN UPPER(kod) LIKE 'E%' THEN maxbodu ELSE 0 END) / 2.0 as "Max bodů v E"
    FROM Hodnoceni
    GROUP BY id_noshodnoceni, id_souborkrit
),
RadniHodnotitele AS (
    -- Získáme pouze řádná hodnocení, agregovaná na úroveň hodnotitele
    SELECT 
        id_noshodnoceni,
        id_souborkrit,
        kod_hodnotitele,
        body_v_posudku,
        ROW_NUMBER() OVER (PARTITION BY id_noshodnoceni, id_souborkrit ORDER BY kod_hodnotitele) AS rn
    FROM (
        SELECT DISTINCT 
            id_noshodnoceni,
            id_souborkrit,
            kod_hodnotitele,
            body_v_posudku
        FROM Hodnoceni
        WHERE opravnehodnoceni = 'N'
    ) h
),
Rozdil AS (
    SELECT 
        r1.id_noshodnoceni,
        r1.id_souborkrit,
        r1.kod_hodnotitele as kod_hodnotitele_1,
        r1.body_v_posudku as body_1,
        r2.kod_hodnotitele as kod_hodnotitele_2,
        r2.body_v_posudku as body_2,
        ABS(r1.body_v_posudku - r2.body_v_posudku) as rozdil_bodu
    FROM RadniHodnotitele r1
    INNER JOIN RadniHodnotitele r2 
      ON r1.id_noshodnoceni = r2.id_noshodnoceni 
     AND r1.id_souborkrit = r2.id_souborkrit
     AND r1.rn = 1 
     AND r2.rn = 2
)
SELECT  
    sc.nazev "SC",
    v."Číslo výzvy",
    v."Název výzvy",
    p."Registrační číslo projektu",
    p.zadatel,
    p.kodwfstav "Stav projektu",
    hs.p23 "Datum přepnutí stavu po VH",
    sh.pocetbodu "Celkem bodů ve VH",
    ci."Název" "Status hodnocení VH",
    COALESCE(kategorie."Splněné bináry v A", 'Ne') "Splněné bináry v A",
    COALESCE(kategorie."Opravné hodnocení v A", 'Ne') "Opravné hodnocení v A",
    kategorie."Počet bodů v B",
    kategorie."Max bodů v B",
    CASE 
        WHEN kategorie."Max bodů v B" > 0 
        THEN kategorie."Počet bodů v B" / kategorie."Max bodů v B" 
        ELSE NULL 
    END "Procent v B",
    COALESCE(kategorie."Opravné hodnocení v B", 'Ne') "Opravné hodnocení v B",
    kategorie."Počet bodů v C",
    kategorie."Max bodů v C",
    CASE 
        WHEN kategorie."Max bodů v C" > 0 
        THEN kategorie."Počet bodů v C" / kategorie."Max bodů v C" 
        ELSE NULL 
    END "Procent v C",
    COALESCE(kategorie."Opravné hodnocení v C", 'Ne') "Opravné hodnocení v C",
    kategorie."Počet bodů v D",
    kategorie."Max bodů v D",
    CASE 
        WHEN kategorie."Max bodů v D" > 0 
        THEN kategorie."Počet bodů v D" / kategorie."Max bodů v D" 
        ELSE NULL 
    END "Procent v D",
    COALESCE(kategorie."Opravné hodnocení v D", 'Ne') "Opravné hodnocení v D",
    kategorie."Počet bodů v E",
    kategorie."Max bodů v E",
    CASE 
        WHEN kategorie."Max bodů v E" > 0 
        THEN kategorie."Počet bodů v E" / kategorie."Max bodů v E" 
        ELSE NULL 
    END "Procent v E",
    COALESCE(kategorie."Opravné hodnocení v E", 'Ne') "Opravné hodnocení v E",
    r.kod_hodnotitele_1,
    r.body_1,
    r.kod_hodnotitele_2,
    r.body_2,
    r.rozdil_bodu

FROM VyfiltrovaneProjekty p
INNER JOIN isum.v_bi_UmzVyzva v ON v.id = p.id_vyzva 
INNER JOIN isum.v_bi_UMZVYZVAHIERARCHIE vh ON vh.id_vyzva = v.id 
INNER JOIN isum.v_bi_UMSHiSC sc ON sc.id = vh.id_speccil
INNER JOIN isum.v_bi_UMVHodnSoubKritVyz skv ON skv.id_vyzva = v.id AND skv.pocethodnotitelu = 2
INNER JOIN isum.v_bi_UMVHodnStatusdh sh ON sh.id_souborkrit = skv.id_souborkrit AND sh.id_noshodnoceni = p.id 
INNER JOIN isum.v_bi_UmsCisZakladni ci ON ci.id = sh.id_statushodn 
INNER JOIN (
    SELECT nositelid,
    	   MAX(datumod) p23
    FROM isum.v_bi_UmsWFHistorieStavu
    WHERE stavdo IN ('PP22','PP21')
    AND nositelid IN (SELECT id FROM VyfiltrovaneProjekty)
    GROUP BY nositelid ) hs ON hs.NositelId = p.id

INNER JOIN Kategorie kategorie ON kategorie.id_noshodnoceni = p.id 
                               AND kategorie.id_souborkrit = skv.id_souborkrit
INNER JOIN Rozdil r ON r.id_noshodnoceni = p.id 
                   AND r.id_souborkrit = skv.id_souborkrit
WHERE sc."Číslo specifického cíle / oper" IN ('01.3.09.3.1','01.3.10.3.2','01.3.12.3.3','01.3.14.3.4','01.3.15.3.5','01.3.43.3.6')
ORDER BY p."Registrační číslo projektu"
