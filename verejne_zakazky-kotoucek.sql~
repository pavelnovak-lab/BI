p.zadatel,
vz.nazev as nazevvz,
vz.poradovecislo as cislovz,
(select s."Název subjektu"
	from isum.v_bi_UMVVRDodatek d
	inner join isum.v_bi_umsciszakladni typd on typd.id=d.id_typ and typd."Kód"='2'
