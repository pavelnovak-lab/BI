SELECT p."Registraèní èíslo projektu" ,
       p."Název projektu CZ" ,
       gg.czv,
       gg.eu,
       hs.datumod,
       p.zadatel,
       SUBSTR(p.kompetencniutvar, 6) AS "Program podpory" 

FROM isum.v_bi_UmzProjekt p 
INNER JOIN isum.v_bi_UmsWFHistorieStavu hs ON hs.NositelId = p.id
INNER JOIN isum.v_bi_umzprjgg gg ON gg.id=p.id 


WHERE p."Registraèní èíslo projektu" is not null
AND p.KodPrioritniOsa in ('01.1', '01.2', '01.3', '01.4','01.5')
AND hs.stavdo = 'PP30'
AND gg.czv > 50000000
AND trunc(hs.datumod) > to_date('2020-12-14','yyyy-mm-dd')
